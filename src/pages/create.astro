---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { repoUrl, siteBase } from '@/lib/buildprints';

const githubIssueBase = `${repoUrl}/issues/new`;
const defaultSubmitBody = `Submit Buildprint

GitHub URL:

What should agents copy from this project?

Checks before submission:
- [ ] The URL is public or reviewer-accessible
- [ ] No secrets, tokens, private customer data, or env values are included
- [ ] License/ownership is clear enough to review

Notes for reviewer:

Registry: ${siteBase}/
`;
const fallbackSubmitUrl = `${githubIssueBase}?title=${encodeURIComponent('[submit-buildprint] GitHub URL')}&body=${encodeURIComponent(defaultSubmitBody)}`;
---
<BaseLayout title="Submit Buildprint — Agent Buildprint" description="Submit a GitHub URL to turn a reusable project, workflow, or Buildprint repo into a registry listing.">
  <main class="create-page submit-buildprint-page">
    <section class="container create-hero submit-hero submit-url-hero">
      <a class="artifact-back" href="/buildprints/">← Browse Buildprints</a>
      <p class="registry-v2-kicker">Submit</p>
      <h1>Submit Buildprint.</h1>
      <p class="registry-v2-lede">Paste the GitHub URL. That’s it. It can be a repo, a folder, or an existing Buildprint package.</p>
    </section>

    <section class="container submit-url-shell" aria-label="Submit Buildprint by GitHub URL">
      <article class="submit-url-card">
        <div class="submit-url-card-copy">
          <span class="create-choice-label">GitHub URL</span>
          <h2>What should agents copy?</h2>
          <p>Send the source. The registry review can decide whether it needs mapping, cleanup, or direct publication.</p>
        </div>
        <form class="submit-url-form" data-submit-form data-issue-base={githubIssueBase} data-site-base={siteBase}>
          <label>
            <span>GitHub URL</span>
            <input name="githubUrl" autocomplete="url" inputmode="url" placeholder="https://github.com/owner/repo" required />
          </label>
          <button class="registry-v2-primary" type="submit">Submit Buildprint</button>
        </form>
        <p class="submit-url-note">Use a repo URL, a folder URL, or a direct Buildprint package URL. No extra form fields for v1.</p>
        <p class="submit-fallback"><a href={fallbackSubmitUrl}>Open blank submission request</a></p>
      </article>
    </section>
  </main>
  <script>
    document.querySelector('[data-submit-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const data = new FormData(form);
      const githubUrl = String(data.get('githubUrl') || '').trim();
      const cleanTarget = githubUrl.replace(/^https?:\/\/github\.com\//, '').replace(/\/$/, '') || 'GitHub URL';
      const body = `Submit Buildprint\n\nGitHub URL: ${githubUrl}\n\nWhat should agents copy from this project?\n\nChecks before submission:\n- [ ] The URL is public or reviewer-accessible\n- [ ] No secrets, tokens, private customer data, or env values are included\n- [ ] License/ownership is clear enough to review\n\nNotes for reviewer:\n\nRegistry: ${form.getAttribute('data-site-base') || 'https://agent-buildprint.com'}/\n`;
      const url = new URL(form.getAttribute('data-issue-base') || 'https://github.com/DomEscobar/agent-buildprint/issues/new');
      url.searchParams.set('title', `[submit-buildprint] ${cleanTarget}`);
      url.searchParams.set('body', body);
      window.location.href = url.href;
    });
  </script>
</BaseLayout>
