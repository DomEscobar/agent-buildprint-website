---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, getBuildprint, packageManifest, siteBase } from '@/lib/buildprints';
import { badgeIcon } from '@/lib/icons';

export function getStaticPaths() {
  return buildprints.map((bp) => ({ params: { slug: bp.slug } }));
}

const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');

const manifest = packageManifest(bp);
const detailStatus = bp.planned || bp.status === 'coming-soon' ? 'Planned' : bp.status === 'validated' ? 'Validated' : bp.status === 'draft' ? 'Draft' : bp.checks.length ? 'Checked' : 'Ready';
const startCommand = `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const originName = bp.originLabel ?? bp.originGithubUrl?.replace('https://github.com/', '');
---
<BaseLayout title={`${bp.title} — Agent Buildprint`} description={bp.summary}>
  <main class="readme-page">
    <article class="container readme-shell">
      <header class="readme-header">
        <a class="readme-back" href="/buildprints/">← Buildprints</a>
        <h1>{bp.title}</h1>
        <p class="readme-lead">{bp.promise}</p>
        <div class="readme-badges">
          <span><b>{badgeIcon(bp.category)}</b>{bp.category}</span>
          <span><b>{badgeIcon(bp.status)}</b>{detailStatus}</span>
          <span>{bp.difficulty}</span>
          {bp.stack.slice(0, 4).map((item) => <span>{item}</span>)}
        </div>
        <div class="readme-links">
          <button class="readme-primary-action copy-btn" data-copy={bp.copyPrompt}>Copy agent prompt</button>
          <a href={`/buildprints/${bp.slug}/package.json`}>Package JSON</a>
          <a href={bp.githubUrl}>Buildprint files</a>
          {bp.originGithubUrl ? <a href={bp.originGithubUrl} target="_blank" rel="noreferrer">Source repo: {originName}</a> : null}
        </div>
      </header>

      <section class="markdown-body">
        <h2>Overview</h2>
        <p>{bp.summary}</p>

        <h2>Use this when</h2>
        {bp.includes.length ? <ul>{bp.includes.slice(0, 8).map((item) => <li>{item}</li>)}</ul> : <p>Package details are still being prepared.</p>}

        <h2>Quick start</h2>
        <p>Fetch the exact Buildprint package into your project:</p>
        <div class="readme-code-row">
          <code>{startCommand}</code>
          <button class="copy-inline copy-btn" data-copy={startCommand}>Copy</button>
        </div>

        <h2>Key docs</h2>
        <p>Start with these. They are the files most coding agents and reviewers actually need.</p>
        <div class="readme-file-list compact-doc-list">
          {bp.files.filter((file) => ['BUILDPRINT.md', 'SPEC.md', 'PLAN.md', 'CONTRACTS.md', 'TEST_MATRIX.md', 'PARITY_CLAIMS.md', 'HEAD_TO_FOOT_QA.md', 'QA_PLAN.md'].includes(file.path)).slice(0, 7).map((file) => {
            const fileUrl = `${bp.rawBaseUrl}/${file.path}`;
            return <div class="readme-file-item key-doc-item">
              <a href={fileUrl}><code>{file.path}</code></a>
              <p>{file.purpose}</p>
            </div>;
          })}
        </div>

        <details class="readme-details">
          <summary>All package files</summary>
          <div class="readme-file-list all-files-list">
            {bp.files.map((file) => {
              const fileUrl = `${bp.rawBaseUrl}/${file.path}`;
              const copyUrl = fileUrl.startsWith('http') ? fileUrl : `${siteBase}${fileUrl}`;
              return <div class="readme-file-item">
                <a href={fileUrl}><code>{file.path}</code></a>
                <p>{file.purpose}</p>
                <button class="copy-inline copy-btn" data-copy={copyUrl}>Copy URL</button>
              </div>;
            })}
          </div>
        </details>

        <h2>Validation</h2>
        {bp.trustBadges?.length ? <ul>{bp.trustBadges.map((badge) => <li><strong>{badge.label}:</strong> {badge.detail}</li>)}</ul> : bp.checks.length ? <ul>{bp.checks.map((check) => <li>{check}</li>)}</ul> : <p>Checks will be added before this Buildprint is publishable.</p>}

        {bp.checks.length ? <>
          <h3>Quality gates</h3>
          <ul>{bp.checks.map((check) => <li>{check}</li>)}</ul>
        </> : null}

        <h2>Boundaries / non-goals</h2>
        {bp.risks.length ? <ul>{bp.risks.map((risk) => <li>{risk}</li>)}</ul> : <p>Risk coverage will be listed with the final package.</p>}

        <h2>Links</h2>
        <ul>
          <li><a href={`/buildprints/${bp.slug}/package.json`}>Manifest JSON</a></li>
          <li><a href={`/buildprints/${bp.slug}/agent.md`}>Agent guide</a></li>
          <li><a href={`/buildprints/${bp.slug}/prompt.txt`}>Prompt text</a></li>
          <li><a href={bp.githubUrl}>Buildprint files on GitHub</a></li>
          {bp.originGithubUrl ? <li><a href={bp.originGithubUrl} target="_blank" rel="noreferrer">Original/source GitHub repo: {originName}</a></li> : null}
        </ul>

        <details class="readme-details">
          <summary>Manifest preview</summary>
          <pre>{JSON.stringify({ slug: bp.slug, title: bp.title, tier: bp.tier, category: bp.category, status: bp.status, originGithub: bp.originGithubUrl, agent: manifest.entrypoints.agent, manifest: manifest.entrypoints.manifest }, null, 2)}</pre>
        </details>
      </section>
    </article>
  </main>
  <script>
    function copyText(value) {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(value);
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      return Promise.resolve();
    }

    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.setAttribute('data-label', button.textContent || 'Copy');
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-copy') || '';
        const original = button.getAttribute('data-label') || 'Copy';
        button.textContent = 'Copied ✓';
        button.classList.add('copied');
        button.setAttribute('aria-live', 'polite');
        copyText(value).catch(() => {
          button.textContent = 'Copy failed';
        });
        setTimeout(() => {
          button.textContent = original;
          button.classList.remove('copied');
        }, 2200);
      });
    });
  </script>
</BaseLayout>
