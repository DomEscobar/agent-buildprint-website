---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, getBuildprint, packageManifest, siteBase } from '@/lib/buildprints';

export function getStaticPaths() {
  return buildprints.map((bp) => ({ params: { slug: bp.slug } }));
}

const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');

const manifest = packageManifest(bp);
const sourceMatch = bp.githubUrl.match(/github\.com\/([^/]+)\/([^/]+)(?:\/tree\/([^/]+)\/(.+))?/);
const sourceOwner = sourceMatch?.[1] ?? 'DomEscobar';
const sourceRepo = sourceMatch ? `${sourceMatch[1]}/${sourceMatch[2]}` : 'DomEscobar/agent-buildprint';
const sourceBranch = sourceMatch?.[3] ?? 'main';
const sourcePath = sourceMatch?.[4] ?? `buildprints/${bp.slug}`;
const ownerHandle = bp.creator.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || sourceOwner.toLowerCase();
const description = bp.plainDescription ?? bp.summary;
const entrypoint = manifest.canonicalStart ?? bp.files.find((file) => file.path === 'BUILDPRINT.md')?.path ?? bp.files[0]?.path ?? 'BUILDPRINT.md';
const startCommand = manifest.bootstrap?.command ?? `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const fallbackCommand = manifest.bootstrap?.fallbackCommand;
const copyPrompt = bp.copyPrompt || `Use the ${bp.title} Buildprint. First bootstrap exact snapshots: ${startCommand} . Then read .buildprint/next-agent.md and continue.`;
const updatedDate = bp.updatedAt ? new Date(bp.updatedAt) : null;
const updatedLabel = updatedDate && !Number.isNaN(updatedDate.getTime())
  ? updatedDate.toLocaleString('en', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Source synced';
const readOrder = manifest.readOrder?.length ? manifest.readOrder : [entrypoint];
const readOrderFiles = readOrder.map((filePath) => bp.files.find((file) => file.path === filePath)).filter(Boolean);
const fileTree = bp.files.map((file) => ({ ...file, rawUrl: `${bp.rawBaseUrl}/${file.path}` }));
const topLevelCount = new Set(bp.files.map((file) => file.path.split('/')[0])).size;
const hasRunArtifact = Boolean(bp.proofUrl || bp.visualRun?.demoUrl);
const runRows = hasRunArtifact ? [
  {
    status: 'linked',
    label: bp.proofUrl ? 'Proof artifact' : 'Visual artifact',
    command: 'Maintainer supplied public artifact',
    output: bp.proofUrl ?? bp.visualRun?.demoUrl,
    checks: bp.checks.slice(0, 4),
  },
] : [];
const rawEntrypointUrl = `${bp.rawBaseUrl}/${entrypoint}`;
const packageUrl = `${siteBase}/buildprints/${bp.slug}/package.json`;
const agentUrl = `${siteBase}/buildprints/${bp.slug}/agent.md`;
const promptUrl = `${siteBase}/buildprints/${bp.slug}/prompt.txt`;
---
<BaseLayout title={`${bp.title} by @${ownerHandle} - Agent Buildprint`} description={description}>
  <main class="artifact-page">
    <section class="artifact-hero">
      <div class="container artifact-hero-grid">
        <div class="artifact-heading">
          <a class="artifact-back" href="/buildprints/">← Explore</a>
          <p class="artifact-path"><span>@{ownerHandle}</span><span>/</span><strong>{bp.slug}</strong></p>
          <h1>{bp.title}</h1>
          <p class="artifact-summary">{description}</p>
          <div class="artifact-actions">
            <button class="artifact-primary copy-btn" data-copy={copyPrompt}>Copy agent prompt</button>
            <button class="copy-btn" data-copy={startCommand}>Copy start command</button>
            <a href={bp.githubUrl} target="_blank" rel="noreferrer">View source</a>
          </div>
        </div>
        <aside class="artifact-use-panel" aria-label="Use this Buildprint">
          <div class="artifact-panel-head">
            <span>Use this</span>
            <b>{entrypoint}</b>
          </div>
          <div class="artifact-command">
            <code>{startCommand}</code>
            <button class="copy-btn" data-copy={startCommand}>Copy</button>
          </div>
          <dl class="artifact-quick-facts">
            <div><dt>Source</dt><dd>{sourceRepo}</dd></div>
            <div><dt>Path</dt><dd>{sourcePath}</dd></div>
            <div><dt>Branch</dt><dd>{sourceBranch}</dd></div>
            <div><dt>Last sync</dt><dd>{updatedLabel}</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="container artifact-layout">
      <aside class="artifact-sidebar" aria-label="Artifact facts">
        <nav>
          <a href="#overview">Overview</a>
          <a href="#use">Use</a>
          <a href="#files">Files</a>
          <a href="#runs">Runs</a>
          <a href="#source">Source</a>
        </nav>
        <div class="artifact-side-card">
          <span>Registry check</span>
          <strong>Fetchable</strong>
          <p>{bp.files.length} files indexed from GitHub source.</p>
        </div>
        <div class="artifact-side-card">
          <span>Public runs</span>
          <strong>{runRows.length}</strong>
          <p>{runRows.length ? 'Maintainer artifacts are linked below.' : 'No public execution runs have been published yet.'}</p>
        </div>
      </aside>

      <div class="artifact-content">
        <section class="artifact-section" id="overview">
          <div class="artifact-section-title">
            <span>Overview</span>
            <h2>What this Buildprint is for</h2>
          </div>
          <div class="artifact-card artifact-prose">
            <p>{bp.promise || description}</p>
            <div class="artifact-columns">
              <div>
                <h3>Runtime surface</h3>
                <ul>{bp.runtime.slice(0, 7).map((item) => <li>{item}</li>)}</ul>
              </div>
              <div>
                <h3>Build materials</h3>
                <ul>{bp.stack.slice(0, 7).map((item) => <li>{item}</li>)}</ul>
              </div>
            </div>
          </div>
        </section>

        <section class="artifact-section" id="use">
          <div class="artifact-section-title">
            <span>Use</span>
            <h2>Start from exact snapshots</h2>
          </div>
          <div class="artifact-card artifact-use-grid">
            <div>
              <h3>Agent prompt</h3>
              <p>Copy this into Codex, Claude Code, Cursor, OpenClaw, or another coding agent. It points the agent at exact snapshots rather than page text.</p>
              <pre>{copyPrompt}</pre>
              <button class="copy-btn artifact-inline-button" data-copy={copyPrompt}>Copy prompt</button>
            </div>
            <div>
              <h3>Commands and URLs</h3>
              <div class="artifact-endpoint-list">
                <div><span>Start</span><code>{startCommand}</code><button class="copy-btn" data-copy={startCommand}>Copy</button></div>
                {fallbackCommand ? <div><span>Fallback</span><code>{fallbackCommand}</code><button class="copy-btn" data-copy={fallbackCommand}>Copy</button></div> : null}
                <div><span>Package</span><code>{packageUrl}</code><button class="copy-btn" data-copy={packageUrl}>Copy</button></div>
                <div><span>Agent guide</span><code>{agentUrl}</code><button class="copy-btn" data-copy={agentUrl}>Copy</button></div>
                <div><span>Prompt text</span><code>{promptUrl}</code><button class="copy-btn" data-copy={promptUrl}>Copy</button></div>
              </div>
            </div>
          </div>
        </section>

        <section class="artifact-section" id="files">
          <div class="artifact-section-title">
            <span>Files</span>
            <h2>Entrypoint and source tree</h2>
          </div>
          <div class="artifact-card artifact-files">
            <div class="artifact-file-head">
              <div><span>Entrypoint</span><strong>{entrypoint}</strong></div>
              <div><span>Top-level groups</span><strong>{topLevelCount}</strong></div>
              <div><span>Total files</span><strong>{bp.files.length}</strong></div>
            </div>
            <div class="artifact-read-order">
              <h3>Declared read order</h3>
              {readOrderFiles.length ? <ol>{readOrderFiles.map((file) => <li><a href={`${bp.rawBaseUrl}/${file.path}`}>{file.path}</a><small>{file.purpose}</small></li>)}</ol> : <p>No explicit read order. Start with <a href={rawEntrypointUrl}>{entrypoint}</a>.</p>}
            </div>
            <details open>
              <summary>File browser</summary>
              <div class="artifact-file-list">
                {fileTree.map((file) => (
                  <div>
                    <a href={file.rawUrl}><code>{file.path}</code></a>
                    <span>{file.purpose}</span>
                    <button class="copy-btn" data-copy={file.rawUrl}>Copy raw</button>
                  </div>
                ))}
              </div>
            </details>
          </div>
        </section>

        <section class="artifact-section" id="runs">
          <div class="artifact-section-title">
            <span>Runs</span>
            <h2>Execution facts, not badges</h2>
          </div>
          <div class="artifact-card">
            {runRows.length ? (
              <div class="artifact-run-list">
                {runRows.map((run) => <article>
                  <header><strong>{run.label}</strong><span>{run.status}</span></header>
                  <p>{run.command}</p>
                  {run.output ? <a href={run.output}>Open artifact</a> : null}
                  {run.checks.length ? <ul>{run.checks.map((check) => <li>{check}</li>)}</ul> : null}
                </article>)}
              </div>
            ) : (
              <div class="artifact-empty-run">
                <h3>No public execution runs yet.</h3>
                <p>This does not mean the Buildprint is bad. It means the registry does not yet have a published run with command, logs, checks, and output artifacts for this version.</p>
              </div>
            )}
          </div>
        </section>

        <section class="artifact-section" id="source">
          <div class="artifact-section-title">
            <span>Source</span>
            <h2>GitHub ownership and sync facts</h2>
          </div>
          <div class="artifact-card artifact-source-grid">
            <div><span>Repository</span><strong>{sourceRepo}</strong></div>
            <div><span>Owner</span><strong>{sourceOwner}</strong></div>
            <div><span>Branch</span><strong>{sourceBranch}</strong></div>
            <div><span>Path</span><strong>{sourcePath}</strong></div>
            <div><span>Manifest</span><strong>package.json</strong></div>
            <div><span>Raw base</span><strong>{bp.rawBaseUrl}</strong></div>
          </div>
        </section>
      </div>
    </section>
  </main>
  <script>
    function copyText(value) {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(value);
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      return Promise.resolve();
    }
    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy') || '';
        await copyText(value);
        const previous = button.textContent;
        button.textContent = 'Copied';
        button.classList.add('copied');
        setTimeout(() => { button.textContent = previous; button.classList.remove('copied'); }, 1200);
      });
    });
  </script>
</BaseLayout>
