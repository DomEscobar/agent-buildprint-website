---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, getBuildprint, implementationEstimate, packageManifest, siteBase } from '@/lib/buildprints';
import { badgeIcon } from '@/lib/icons';
import TechName from '@/components/TechName.astro';

export function getStaticPaths() {
  return buildprints.map((bp) => ({ params: { slug: bp.slug } }));
}

const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');

const manifest = packageManifest(bp);
const detailStatus = bp.publicStatus?.label ?? (bp.status === 'validated' ? 'Validated' : bp.checks.length ? 'Proof trail' : 'Inspect packet');
const detailStatusTitle = bp.publicStatus?.explanation ?? (bp.status === 'validated' ? 'Validated packet with documented proof boundaries.' : bp.checks.length ? 'This packet lists checks and evidence expectations.' : 'Inspect the packet files before using.');
const isWorkflow = bp.category === 'Workflow OS';
const startCommand = `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const originName = bp.originLabel ?? bp.originGithubUrl?.replace('https://github.com/', '');
const description = bp.plainDescription ?? bp.summary;
const whatYouGet = bp.whatYouGet?.length ? bp.whatYouGet : bp.includes.slice(0, 6);
const rawRequirements = bp.whatYouNeed?.length ? bp.whatYouNeed : ['Nothing for local/mock mode', 'Bring API keys or account credentials only if you want live external providers'];
const architectureFlow = bp.architectureFlow?.length ? bp.architectureFlow : bp.stack.slice(0, 7);
const coreCapabilities = bp.resultChecklist?.length ? bp.resultChecklist : whatYouGet;
const checkedScope = bp.trustBadges?.length
  ? bp.trustBadges.slice(0, 4).map((badge) => badge.label)
  : bp.checks.slice(0, 4);
const outOfScope = bp.risks.slice(0, 4);
const packetOrder = manifest.readOrder?.length
  ? manifest.readOrder
  : ['BUILDPRINT.md', 'START_HERE.md', 'blueprint.yaml', '02-context/context-map.yaml', '03-capabilities/capability-index.yaml', '08-evaluation/acceptance.yaml', '09-evidence/evidence-ledger.jsonl'];
const packetFiles = packetOrder
  .map((filePath) => bp.files.find((file) => file.path === filePath))
  .filter(Boolean)
  .slice(0, 8);
const mockRequirement = rawRequirements.find((item) => /nothing/i.test(item));
const additionalRequirements = rawRequirements.filter((item) => item !== mockRequirement).slice(0, 5);
const baselineRequirementLabel = mockRequirement && /mock|local/i.test(mockRequirement) ? 'Mock/local' : 'Baseline';
const updatedDate = bp.updatedAt ? new Date(bp.updatedAt) : null;
const updatedLabel = updatedDate && !Number.isNaN(updatedDate.getTime())
  ? updatedDate.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })
  : 'Not dated';
const visualHref = (value?: string) => {
  if (!value) return undefined;
  if (/^https?:\/\//.test(value) || value.startsWith('/')) return value;
  return `${bp.rawBaseUrl}/${value.replace(/^\.?\//, '')}`;
};
const visualImageAliases: Record<string, string[]> = {
  'ai-influencer-os': ['instagram'],
  'automated-ai-blog-os': ['blog'],
};
const publicVisualImage = ['png', 'jpg', 'jpeg', 'webp']
  .flatMap((extension) => [bp.slug, ...(visualImageAliases[bp.slug] ?? [])].map((name) => ({
    filePath: path.join(process.cwd(), 'public', 'images', 'buildprints', `${name}.${extension}`),
    href: `/images/buildprints/${name}.${extension}`,
  })))
  .find((candidate) => fs.existsSync(candidate.filePath))?.href;
const visualImage = visualHref(bp.visualRun?.image) ?? publicVisualImage;
const visualDemo = visualHref(bp.visualRun?.demoUrl);
const proofHref = visualHref(bp.proofUrl);
const heroStyle = visualImage ? `--detail-visual-image: url('${visualImage.replaceAll("'", '%27')}');` : undefined;
const primaryProofHref = proofHref ?? visualDemo;
const visualPacketFiles = Array.from(new Set([
  manifest.canonicalStart,
  ...packetFiles.map((file) => file.path),
  'package.json',
  'agent.md',
])).slice(0, 3);
const systemShape = [
  {
    label: isWorkflow ? 'Workflow surface' : 'Product surface',
    value: bp.promise || description,
  },
  {
    label: 'Runtime layer',
    value: bp.runtime.length ? bp.runtime.join(', ') : 'Runtime is selected by the implementing agent.',
  },
  {
    label: 'Build materials',
    value: architectureFlow.length ? architectureFlow.slice(0, 4).join(' / ') : bp.stack.slice(0, 4).join(' / '),
  },
  {
    label: 'Proof boundary',
    value: checkedScope.length ? checkedScope.slice(0, 2).join(' / ') : detailStatus,
  },
];
const scopeBring = additionalRequirements.length
  ? additionalRequirements
  : ['Target repo constraints', 'Provider credentials for live integrations', 'Deployment and production policy choices'];
---
<BaseLayout title={`${bp.title} - Agent Buildprint`} description={description}>
  <main class="detail-overhaul" data-category={bp.category} data-status={bp.status}>
    <section class="detail-hero" style={heroStyle}>
      <div class="detail-hero-bg" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="container detail-hero-inner">
        <div class="detail-title-block">
          <a class="detail-back" href="/buildprints/">Back to registry</a>
          <div class="detail-kicker">
            <span>{badgeIcon(bp.category)} {bp.category}</span>
            <span title={detailStatusTitle}>{badgeIcon(bp.status)} {detailStatus}</span>
            <span>Updated {updatedLabel}</span>
          </div>
          <h1>{bp.title}</h1>
          <p>{description}</p>
          <div class="detail-hero-actions">
            <button class="detail-primary copy-btn" data-copy={bp.copyPrompt}>Copy agent prompt</button>
            <a href={`/buildprints/${bp.slug}/package.json`}>Package JSON</a>
            {primaryProofHref ? <a href={primaryProofHref}>Proof / demo</a> : null}
            {bp.originGithubUrl ? <a href={bp.originGithubUrl} target="_blank" rel="noreferrer">Source: {originName}</a> : null}
          </div>
          <div class="detail-engagement" data-buildprint-engagement data-slug={bp.slug} aria-live="polite">
            <div class="detail-engagement-stat">
              <b data-view-count>--</b>
              <span>views</span>
            </div>
            <button class="detail-like-button" type="button" data-like-button aria-pressed="false">
              <span aria-hidden="true" data-like-icon>♡</span>
              <b data-like-count>--</b>
              <span>likes</span>
            </button>
          </div>
        </div>

        <aside class={`detail-visual ${visualImage ? 'has-image' : ''}`} aria-label="Buildprint visual summary">
          {visualImage ? <img src={visualImage} alt={bp.visualRun?.alt ?? `${bp.title} visual run`} loading="eager" /> : <div class="visual-fallback">
            <div class="visual-topline">
              <span>{bp.tier}</span>
              <b>{detailStatus}</b>
            </div>
            <div class="visual-packet-stack">
              {visualPacketFiles.map((file) => <span>{file}</span>)}
            </div>
            <div class="visual-flow" aria-hidden="true">
              {architectureFlow.slice(0, 4).map((step) => <span>{step}</span>)}
            </div>
          </div>}
          <div class="visual-caption">
            <b>{bp.visualRun?.status ?? (visualImage ? 'Visual run' : 'Generated packet view')}</b>
            <span>{bp.visualRun?.caption ?? `${bp.files.length} package files - ${implementationEstimate(bp)} ${isWorkflow ? 'workflow pass' : 'implementation pass'}`}</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="container detail-card-deck" aria-label="Buildprint details">
      <article class="detail-card detail-card-wide">
        <span>What this builds</span>
        <h2>{isWorkflow ? 'A reusable agent workflow packet.' : 'A scoped product implementation packet.'}</h2>
        <div class="detail-outcome-grid">
          <p>{bp.promise || description}</p>
          <ul>
            {whatYouGet.slice(0, 6).map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </article>

      <article class="detail-card detail-card-wide detail-capability-card">
        <span>Core capabilities</span>
        <h2>The useful parts the finished build should expose.</h2>
        <div class="detail-capability-grid">
          {coreCapabilities.slice(0, 6).map((item, index) => <div>
            <small>{String(index + 1).padStart(2, '0')}</small>
            <b>{item}</b>
          </div>)}
        </div>
      </article>

      <article class="detail-card">
        <span>What you need</span>
        <h2>Local first, live proof explicit.</h2>
        {mockRequirement ? <p><strong>{baselineRequirementLabel}:</strong> {mockRequirement}</p> : null}
        <ul>
          {additionalRequirements.length ? additionalRequirements.map((item) => <li>{item}</li>) : <li>No external blocker is listed for first inspection.</li>}
        </ul>
      </article>

      <article class="detail-card detail-system-card">
        <span>System shape</span>
        <h2>What kind of artifact this becomes.</h2>
        <div class="detail-system-list">
          {systemShape.map((item) => <div>
            <small>{item.label}</small>
            <p>{item.value}</p>
          </div>)}
        </div>
      </article>

      <article class="detail-card detail-card-wide detail-scope-card">
        <span>Build scope</span>
        <h2>Included, required from you, and outside the claim.</h2>
        <div class="detail-scope-columns">
          <section>
            <b>Included</b>
            <ul>{whatYouGet.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
          </section>
          <section>
            <b>Bring yourself</b>
            <ul>{scopeBring.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
          </section>
          <section>
            <b>Out of scope</b>
            <ul>{outOfScope.length ? outOfScope.map((item) => <li>{item}</li>) : <li>Production claims beyond the packet evidence are not assumed.</li>}</ul>
          </section>
        </div>
      </article>

      <article class="detail-card detail-handoff-card">
        <span>Agent handoff</span>
        <h2>Start from the packet, not the UI.</h2>
        <div class="detail-command-row">
          <code>{startCommand}</code>
          <button class="copy-inline copy-btn" data-copy={startCommand}>Copy</button>
        </div>
        <div class="detail-handoff-links">
          <a href={`/buildprints/${bp.slug}/agent.md`}>Agent guide</a>
          <a href={`/buildprints/${bp.slug}/package.json`}>Manifest</a>
          <a href={bp.githubUrl}><TechName name="GitHub" /> files</a>
        </div>
      </article>

      <article class="detail-card detail-card-wide detail-files-card">
        <span>Key files</span>
        <h2>The first files an agent should read.</h2>
        <div class="detail-file-grid">
          {packetFiles.map((file) => <a href={`${bp.rawBaseUrl}/${file.path}`}>
            <code>{file.path}</code>
            <small>{file.purpose}</small>
          </a>)}
        </div>
        <details class="detail-all-files">
          <summary>All package files</summary>
          <div class="detail-all-file-list">
            {bp.files.map((file) => {
              const fileUrl = `${bp.rawBaseUrl}/${file.path}`;
              const copyUrl = fileUrl.startsWith('http') ? fileUrl : `${siteBase}${fileUrl}`;
              return <div>
                <a href={fileUrl}><code>{file.path}</code></a>
                <span>{file.purpose}</span>
                <button class="copy-inline copy-btn" data-copy={copyUrl}>Copy URL</button>
              </div>;
            })}
          </div>
        </details>
      </article>
    </section>
  </main>
  <script>
    function copyText(value) {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(value);
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      return Promise.resolve();
    }

    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.setAttribute('data-label', button.textContent || 'Copy');
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-copy') || '';
        const original = button.getAttribute('data-label') || 'Copy';
        button.textContent = 'Copied';
        button.classList.add('copied');
        button.setAttribute('aria-live', 'polite');
        copyText(value).catch(() => {
          button.textContent = 'Copy failed';
        });
        setTimeout(() => {
          button.textContent = original;
          button.classList.remove('copied');
        }, 2200);
      });
    });

    const engagement = document.querySelector('[data-buildprint-engagement]');
    if (engagement) {
      const slug = engagement.getAttribute('data-slug');
      const viewCount = engagement.querySelector('[data-view-count]');
      const likeCount = engagement.querySelector('[data-like-count]');
      const likeButton = engagement.querySelector('[data-like-button]');
      const likeIcon = engagement.querySelector('[data-like-icon]');
      const numberFormat = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });

      function fallbackUuid() {
        const bytes = new Uint8Array(16);
        crypto.getRandomValues(bytes);
        bytes[6] = (bytes[6] & 0x0f) | 0x40;
        bytes[8] = (bytes[8] & 0x3f) | 0x80;
        const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
        return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
      }

      function getClientId() {
        try {
          const existing = localStorage.getItem('agb_client_id');
          if (existing) return existing;
          const next = crypto.randomUUID ? crypto.randomUUID() : fallbackUuid();
          localStorage.setItem('agb_client_id', next);
          return next;
        } catch {
          return crypto.randomUUID ? crypto.randomUUID() : fallbackUuid();
        }
      }

      function setCounts(payload) {
        if (viewCount) viewCount.textContent = numberFormat.format(payload.views || 0);
        if (likeCount) likeCount.textContent = numberFormat.format(payload.likes || 0);
        if (likeButton) likeButton.setAttribute('aria-pressed', payload.liked ? 'true' : 'false');
        if (likeIcon) likeIcon.textContent = payload.liked ? '♥' : '♡';
      }

      function setUnavailable() {
        engagement.setAttribute('data-state', 'unavailable');
        if (viewCount) viewCount.textContent = '-';
        if (likeCount) likeCount.textContent = '-';
        if (likeButton) likeButton.setAttribute('disabled', '');
      }

      async function engagementRequest(path, options) {
        const response = await fetch(path, {
          ...options,
          headers: {
            'content-type': 'application/json',
            ...(options?.headers || {}),
          },
        });
        if (!response.ok) throw new Error('engagement_request_failed');
        return response.json();
      }

      const clientId = slug ? getClientId() : '';
      if (!slug || !clientId) {
        setUnavailable();
      } else {
        const basePath = `/api/buildprints/${encodeURIComponent(slug)}`;
        engagementRequest(`${basePath}/engagement?clientId=${encodeURIComponent(clientId)}`)
          .then(setCounts)
          .then(() => engagementRequest(`${basePath}/view`, {
            method: 'POST',
            body: JSON.stringify({ clientId }),
          }))
          .then(setCounts)
          .catch(setUnavailable);

        likeButton?.addEventListener('click', async () => {
          if (likeButton.hasAttribute('disabled')) return;
          likeButton.setAttribute('disabled', '');
          try {
            setCounts(await engagementRequest(`${basePath}/like`, {
              method: 'POST',
              body: JSON.stringify({ clientId }),
            }));
          } catch {
            engagement.setAttribute('data-state', 'unavailable');
          } finally {
            likeButton.removeAttribute('disabled');
          }
        });
      }
    }
  </script>
</BaseLayout>
