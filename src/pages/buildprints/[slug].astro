---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MarkdownIt from 'markdown-it';
import { buildprints, buildprintFileText, getBuildprint, packageManifest, repoUrl, siteBase } from '@/lib/buildprints';
import { categoryIcon, registryBadgeIcon } from '@/lib/icons';
import { contextEstimateFor, signalFor } from '@/lib/registry';

export function getStaticPaths() {
  return buildprints.map((bp) => ({ params: { slug: bp.slug } }));
}

const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');

const manifest = packageManifest(bp);
const packageSourceUrl = bp.githubUrl;
const packageMatch = packageSourceUrl.match(/github\.com\/([^/]+)\/([^/]+)(?:\/tree\/([^/]+)\/(.+))?/);
const packageOwner = packageMatch?.[1] ?? 'DomEscobar';
const packageRepo = packageMatch ? `${packageMatch[1]}/${packageMatch[2]}` : 'DomEscobar/agent-buildprint';
const packagePath = packageMatch?.[4] ? `/${packageMatch[4]}` : '';
const packageRepoLabel = `${packageRepo}${packagePath}`;
const originSourceUrl = bp.originGithubUrl;
const originMatch = originSourceUrl?.match(/github\.com\/([^/]+)\/([^/]+)(?:\/tree\/([^/]+)\/(.+))?/);
const originRepoLabel = bp.originLabel ?? (originMatch ? `${originMatch[1]}/${originMatch[2]}` : originSourceUrl);
const ownerHandle = bp.creator.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || packageOwner.toLowerCase();
const description = bp.plainDescription ?? bp.summary;
const entrypoint = manifest.canonicalStart ?? bp.files.find((file) => file.path === 'BUILDPRINT.md')?.path ?? bp.files[0]?.path ?? 'BUILDPRINT.md';
const startCommand = manifest.bootstrap?.command ?? `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const fallbackCommand = manifest.bootstrap?.fallbackCommand;
const updatedDate = bp.updatedAt ? new Date(bp.updatedAt) : null;
const updatedLabel = updatedDate && !Number.isNaN(updatedDate.getTime())
  ? updatedDate.toLocaleString('en', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Source synced';
const readOrder = manifest.readOrder?.length ? manifest.readOrder : [entrypoint];
const readOrderFiles = readOrder.map((filePath) => bp.files.find((file) => file.path === filePath)).filter(Boolean);
const topLevelCount = new Set(bp.files.map((file) => file.path.split('/')[0])).size;
const hasRunArtifact = Boolean(bp.proofUrl || bp.visualRun?.demoUrl);
const proofLinks = bp.slug === 'rbac-permissions' ? [
  {
    label: 'Fixture proof',
    href: '/proofs/rbac-permissions-fixture-proof/',
    meta: 'Mini host fixture, 4/4 tests, no external keys.',
  },
  {
    label: 'Umami real-app proof',
    href: '/proofs/rbac-permissions-umami-real-app-proof/',
    meta: 'Real OSS app integration fixture, 4/4 focused tests.',
  },
] : [];
const runRows = hasRunArtifact ? [
  {
    status: 'linked',
    label: bp.proofUrl ? 'Proof artifact' : 'Visual artifact',
    command: 'Maintainer supplied public artifact',
    output: bp.proofUrl ?? bp.visualRun?.demoUrl,
    checks: bp.checks.slice(0, 4),
  },
] : [];
const rawEntrypointUrl = `${bp.rawBaseUrl}/${entrypoint}`;
const promptUrl = `${siteBase}/buildprints/${bp.slug}/prompt.txt`;
const agentPrompt = bp.copyPrompt;

const typeIcon = categoryIcon(bp.category, `${bp.slug} ${bp.title} ${bp.summary}`);
const contextEstimate = await contextEstimateFor(bp);
const estimatedContextLabel = contextEstimate.label;
const estimatedContextTier = contextEstimate.tier;
const bootstrapReady = bp.files.some((file) => file.path === entrypoint) && Boolean(bp.copyPrompt);
const detailSignals = signalFor(bp, bootstrapReady, hasRunArtifact);
const detailBadges = ['Official', ...detailSignals, estimatedContextTier].filter(Boolean) as string[];
const readmeText = await buildprintFileText(bp.slug, 'README.md');
const markdown = new MarkdownIt({
  html: false,
  linkify: true,
  typographer: true,
  breaks: false,
});
const defaultLinkOpen = markdown.renderer.rules.link_open ?? ((tokens, idx, options, _env, self) => self.renderToken(tokens, idx, options));
markdown.renderer.rules.link_open = (tokens, idx, options, env, self) => {
  const token = tokens[idx];
  const href = token.attrGet('href') ?? '';
  if (/^https?:\/\//.test(href)) {
    token.attrSet('target', '_blank');
    token.attrSet('rel', 'noreferrer');
  }
  return defaultLinkOpen(tokens, idx, options, env, self);
};
const readmeHtml = markdown.render(readmeText || description);
---
<BaseLayout title={`${bp.title} by @${ownerHandle} - Agent Buildprint`} description={description}>
  <main class="artifact-page readme-detail-page">
    <section class="artifact-hero readme-detail-hero">
      <div class="container readme-detail-top">
        <a class="artifact-back" href="/buildprints/">← Explore</a>
        <div class="readme-title-row">
          <div class="registry-hf-avatar readme-type-mark" title={bp.category} aria-label={`${bp.category} type`} set:html={typeIcon} />
          <div>
            <p class="artifact-path"><span>@{ownerHandle}</span><span>/</span><strong>{bp.slug}</strong></p>
            <h1>{bp.title}</h1>
            <p class="artifact-summary">{description}</p>
          </div>
        </div>
        <div class="readme-hero-meta" data-detail-engagement data-slug={bp.slug}>
          <span class="readme-meta-chip">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.8 12s3.4-6 9.2-6 9.2 6 9.2 6-3.4 6-9.2 6-9.2-6-9.2-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
            <b data-detail-views>--</b>
            <span>views</span>
          </span>
          <button class="readme-meta-chip readme-like-button" type="button" data-detail-like aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.2s-7.4-4.6-8.7-9.1C2.5 8.2 4.2 5.5 7 5.3c1.7-.1 3.2.8 4 2.1.8-1.3 2.3-2.2 4-2.1 2.8.2 4.5 2.9 3.7 5.8C19.4 15.6 12 20.2 12 20.2Z"/></svg>
            <b data-detail-likes>--</b>
            <span>likes</span>
          </button>
        </div>
      </div>
    </section>

    <section class="container readme-detail-layout">
      <article class="readme-document" id="readme">
        <header class="readme-document-head">
          <span>README.md</span>
          <a href={`${bp.rawBaseUrl}/README.md`}>Raw</a>
        </header>
        <div class="readme-rendered" set:html={readmeHtml} />
      </article>

      <aside class="readme-side-panel" aria-label="Buildprint utility panel">
        <div class="readme-side-card readme-agent-card">
          <span class="side-label">Use this Buildprint</span>
          <button class="artifact-primary copy-btn readme-copy-primary" data-copy={agentPrompt}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 8.2V5.6c0-.9.7-1.6 1.6-1.6h8.1c.9 0 1.6.7 1.6 1.6v8.1c0 .9-.7 1.6-1.6 1.6h-2.6"/><path d="M4.7 8.7h8.1c.9 0 1.6.7 1.6 1.6v8.1c0 .9-.7 1.6-1.6 1.6H4.7c-.9 0-1.6-.7-1.6-1.6v-8.1c0-.9.7-1.6 1.6-1.6Z"/></svg>
            <span>Copy Agent Prompt</span>
          </button>
        </div>

        <div class="readme-side-card readme-facts-card">
          <span class="side-label">Buildprint facts</span>
          <div class="readme-side-facts">
            <div>
              <span>Category</span>
              <strong><span class="readme-side-icon" set:html={typeIcon} />{bp.category}</strong>
            </div>
            <div>
              <span>Updated</span>
              <strong>{updatedLabel}</strong>
            </div>
            <div title="Estimated first-run package context: derived from package file text length plus manifest and bootstrap overhead">
              <span>Estimated tokens</span>
              <strong>{estimatedContextLabel}</strong>
            </div>
            <div>
              <span>Files</span>
              <strong>{bp.files.length}</strong>
            </div>
          </div>
        </div>

        <div class="readme-side-card readme-badges-card">
          <span class="side-label">Status</span>
          <div class="readme-detail-badges" aria-label="Buildprint badges">
            {detailBadges.map((badge) => <span class="submission-badge"><span set:html={registryBadgeIcon(badge)} />{badge}</span>)}
          </div>
        </div>

        {proofLinks.length > 0 && (
          <div class="readme-side-card readme-proof-card">
            <span class="side-label">Proofs</span>
            <div class="readme-proof-list">
              {proofLinks.map((proof) => (
                <a class="readme-proof-link" href={proof.href}>
                  <strong>{proof.label}</strong>
                  <span>{proof.meta}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="readme-side-card readme-source-card">
          <span class="side-label">Buildprint source</span>
          <a class="readme-source-repo" href={packageSourceUrl} target="_blank" rel="noreferrer">{packageRepoLabel}</a>
          {originSourceUrl && originRepoLabel && (
            <>
              <span class="side-label side-label-secondary">Mapped upstream project</span>
              <a class="readme-source-repo readme-package-repo" href={originSourceUrl} target="_blank" rel="noreferrer">{originRepoLabel}</a>
            </>
          )}
        </div>
      </aside>
    </section>
  </main>
  <script>
    function fallbackCopy(value) {
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.inset = '0 auto auto 0';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const copied = document.execCommand('copy');
      textarea.remove();
      if (!copied) throw new Error('Copy command failed');
    }
    async function copyText(value) {
      if (navigator.clipboard?.writeText && window.isSecureContext) {
        try {
          await Promise.race([
            navigator.clipboard.writeText(value),
            new Promise((_, reject) => setTimeout(() => reject(new Error('Clipboard timeout')), 750)),
          ]);
          return;
        } catch (_) {
          // Some browser automation and locked-down contexts expose clipboard APIs that never resolve.
        }
      }
      fallbackCopy(value);
    }
    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy') || '';
        const previous = button.textContent;
        try {
          await copyText(value);
          button.textContent = 'Copied';
          button.classList.add('copied');
        } catch (_) {
          button.textContent = 'Copy failed';
          button.classList.add('copy-failed');
        }
        setTimeout(() => { button.textContent = previous; button.classList.remove('copied', 'copy-failed'); }, 1400);
      });
    });

    const detailEngagement = document.querySelector('[data-detail-engagement][data-slug]');
    const numberFormat = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
    function clientId() {
      const key = 'agb-client-id';
      let value = localStorage.getItem(key);
      if (!value) {
        value = crypto.randomUUID();
        localStorage.setItem(key, value);
      }
      return value;
    }
    function renderEngagement(payload) {
      const views = detailEngagement?.querySelector('[data-detail-views]');
      const likes = detailEngagement?.querySelector('[data-detail-likes]');
      const likeButton = detailEngagement?.querySelector('[data-detail-like]');
      if (views) views.textContent = numberFormat.format(payload.views || 0);
      if (likes) likes.textContent = numberFormat.format(payload.likes || 0);
      if (likeButton) likeButton.setAttribute('aria-pressed', payload.liked ? 'true' : 'false');
    }
    async function postEngagement(action, id) {
      const slug = detailEngagement?.getAttribute('data-slug');
      if (!slug) return null;
      const response = await fetch(`/api/buildprints/${encodeURIComponent(slug)}/${action}`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ clientId: id }),
      });
      if (!response.ok) throw new Error('engagement_unavailable');
      return response.json();
    }
    if (detailEngagement) {
      try {
        const id = clientId();
        renderEngagement(await postEngagement('view', id));
        detailEngagement.querySelector('[data-detail-like]')?.addEventListener('click', async (event) => {
          const button = event.currentTarget;
          button.disabled = true;
          try { renderEngagement(await postEngagement('like', id)); }
          catch (_) { detailEngagement.dataset.state = 'unavailable'; }
          finally { button.disabled = false; }
        });
      } catch (_) {
        detailEngagement.dataset.state = 'unavailable';
      }
    }
  </script>
</BaseLayout>
