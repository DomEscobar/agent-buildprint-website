---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, getBuildprint, packageManifest, siteBase } from '@/lib/buildprints';
export function getStaticPaths() { return buildprints.map((bp) => ({ params: { slug: bp.slug } })); }
const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');
const manifest = packageManifest(bp);
const startCommand = `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const endpoints = [
  { label: 'Agent guide', value: `${siteBase}/buildprints/${bp.slug}/agent.md`, href: `/buildprints/${bp.slug}/agent.md` },
  { label: 'Manifest JSON', value: `${siteBase}/buildprints/${bp.slug}/package.json`, href: `/buildprints/${bp.slug}/package.json` },
  { label: 'Prompt', value: `${siteBase}/buildprints/${bp.slug}/prompt.txt`, href: `/buildprints/${bp.slug}/prompt.txt` },
];
---
<BaseLayout title={`${bp.title} — Agent Buildprint`} description={bp.summary}>
  <main>
    <section class="container hero detail-hero">
      <a class="pill" href="/buildprints/">← Registry</a>
      <h1>{bp.title}</h1>
      <p class="lead">{bp.promise}</p>
      <div class="tags"><span class="tag hot">{bp.category}</span><span class="tag">{bp.tier}</span><span class="tag">{bp.status}</span>{bp.runtime.map((x) => <span class="tag">{x}</span>)}</div>
      <div class="actions"><button class="btn primary copy-btn" data-copy={bp.copyPrompt}>Copy build prompt</button><a class="btn" href={`/buildprints/${bp.slug}/agent.md`}>Agent guide</a><a class="btn" href={`/buildprints/${bp.slug}/package.json`}>Manifest JSON</a><a class="btn" href={bp.githubUrl}>GitHub</a></div>
    </section>

    <section class="container section two-col detail-top">
      <div class="panel command-card">
        <div class="panel-row"><span class="eyebrow">Start command</span><button class="btn copy-btn" data-copy={startCommand}>Copy</button></div>
        <code class="command-line">{startCommand}</code>
        <p>Creates <code>.buildprint/</code>, downloads exact snapshots, and writes continuation state.</p>
      </div>
      <div class="panel endpoint-card">
        <div class="panel-row"><span class="eyebrow">Agent endpoints</span></div>
        {endpoints.map((endpoint) => <div class="endpoint-row"><a href={endpoint.href}>{endpoint.label}</a><code>{endpoint.value.replace(siteBase, '')}</code><button class="copy-inline copy-btn" data-copy={endpoint.value}>Copy</button></div>)}
      </div>
    </section>

    <section class="container section grid columns">
      <div class="panel"><h2>Includes</h2><div class="chip-list">{bp.includes.map((x) => <span>{x}</span>)}</div></div>
      <div class="panel"><h2>Checks</h2><div class="chip-list check-list">{bp.checks.map((x) => <span>{x}</span>)}</div></div>
      <div class="panel"><h2>Risks covered</h2><div class="chip-list risk-list">{bp.risks.map((x) => <span>{x}</span>)}</div></div>
    </section>

    <section class="container section">
      <div class="section-head"><div><span class="eyebrow">Package anatomy</span><h2>Files and agent purposes</h2></div><a class="btn" href={manifest.entrypoints.manifest}>Open manifest</a></div>
      <div class="file-table">
        {bp.files.map((file) => {
          const fileUrl = `/buildprint-files/${bp.slug}/${file.path}`;
          return <div class="file-row">
            <code>{file.path}</code>
            <span>{file.purpose}</span>
            <div class="file-actions"><a href={fileUrl}>Open</a><button class="copy-inline copy-btn" data-copy={`${siteBase}${fileUrl}`}>Copy URL</button></div>
          </div>;
        })}
      </div>
    </section>

    <section class="container section grid columns two">
      <div class="panel code-card">
        <div class="panel-row"><h2>Agent prompt</h2><button class="btn copy-btn" data-copy={bp.copyPrompt}>Copy</button></div>
        <code class="code-block-text">{bp.copyPrompt}</code>
      </div>
      <div class="panel code-card">
        <div class="panel-row"><h2>Manifest preview</h2><button class="btn copy-btn" data-copy={JSON.stringify({ slug: bp.slug, tier: bp.tier, category: bp.category, agent: manifest.entrypoints.agent, manifest: manifest.entrypoints.manifest }, null, 2)}>Copy</button></div>
        <code class="code-block-text">{JSON.stringify({ slug: bp.slug, tier: bp.tier, category: bp.category, agent: manifest.entrypoints.agent, manifest: manifest.entrypoints.manifest }, null, 2)}</code>
      </div>
    </section>
  </main>
  <script>
    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy') || '';
        await navigator.clipboard.writeText(value);
        const old = button.textContent;
        button.textContent = 'Copied';
        setTimeout(() => button.textContent = old, 1100);
      });
    });
  </script>
</BaseLayout>
