---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, getBuildprint, implementationEstimate, packageManifest, siteBase } from '@/lib/buildprints';
import { badgeIcon } from '@/lib/icons';
import TechName from '@/components/TechName.astro';

export function getStaticPaths() {
  return buildprints.map((bp) => ({ params: { slug: bp.slug } }));
}

const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');

const manifest = packageManifest(bp);
const detailStatus = bp.status === 'validated' ? 'Validated' : bp.checks.length ? 'Checked' : 'Ready';
const isWorkflow = bp.category === 'Workflow OS';
const snapshotLabel = isWorkflow ? 'Produces' : 'Builds';
const estimateLabel = isWorkflow ? 'for a first agent workflow pass.' : 'for a first agent implementation pass.';
const startCommand = `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const originName = bp.originLabel ?? bp.originGithubUrl?.replace('https://github.com/', '');
const description = bp.plainDescription ?? bp.summary;
const whatYouGet = bp.whatYouGet?.length ? bp.whatYouGet : bp.includes.slice(0, 6);
const rawRequirements = bp.whatYouNeed?.length ? bp.whatYouNeed : ['Nothing for local/mock mode', 'Bring API keys or account credentials only if you want live external providers'];
const architectureFlow = bp.architectureFlow?.length ? bp.architectureFlow : bp.stack.slice(0, 6);
const proofItems = bp.trustBadges?.length
  ? bp.trustBadges.slice(0, 4).map((badge) => badge.label)
  : bp.checks.slice(0, 4);
const packetOrder = ['BUILDPRINT.md', 'SPEC.md', 'PLAN.md', 'CONTRACTS.md', 'EXECUTION_PROTOCOL.md', 'IMPLEMENTATION_PLAN.md', 'VERIFICATION.md', 'DEFAULT_PRESET.md', 'TEST_MATRIX.md', 'VALIDATION_TEMPLATE.md'];
const packetFiles = packetOrder
  .map((path) => bp.files.find((file) => file.path === path))
  .filter(Boolean)
  .slice(0, 6);
const mockRequirement = rawRequirements.find((item) => /nothing/i.test(item));
const realRequirementTerms = /(api|key|credential|account|access|repo|private|provider|storage|database|webhook|domain|runtime|adapter|corpus|permission)/i;
const fillerRequirementTerms = /(human|taste|decision|policy|direction|choice|list of|critical workflow)/i;
const hardRequirements = rawRequirements
  .filter((item) => !/nothing/i.test(item))
  .filter((item) => realRequirementTerms.test(item) && !fillerRequirementTerms.test(item))
  .slice(0, 5);
const flexibilityItems = ['Tech stack', 'Providers / APIs', 'UI framework', 'Database / storage', 'Deployment target'];
---
<BaseLayout title={`${bp.title} — Agent Buildprint`} description={description}>
  <main class="readme-page">
    <article class="container readme-shell benefit-shell">
      <header class="readme-header benefit-header">
        <a class="readme-back" href="/buildprints/">← Buildprints</a>
        <h1>{bp.title}</h1>
        <p class="readme-lead">{description}</p>
        <div class="readme-meta-line">
          <span><b>{badgeIcon(bp.category)}</b>{bp.category}</span>
          <span><b>{badgeIcon(bp.status)}</b>{detailStatus}</span>
          <span>{bp.stack.slice(0, 3).join(' · ')}</span>
        </div>
        <div class="readme-links">
          <button class="readme-primary-action copy-btn" data-copy={bp.copyPrompt}>Copy agent prompt</button>
          <a href={`/buildprints/${bp.slug}/package.json`}>Package JSON</a>
          {bp.originGithubUrl ? <a href={bp.originGithubUrl} target="_blank" rel="noreferrer">Source repo: {originName}</a> : null}
        </div>
      </header>

      <section class="markdown-body benefit-body detail-blueprint-body">
        <div class="detail-snapshot flat-snapshot" aria-label="Buildprint snapshot">
          <section class="detail-panel">
            <span>{snapshotLabel}</span>
            <ul>{whatYouGet.slice(0, 3).map((item) => <li>{item}</li>)}</ul>
          </section>
          <section class="detail-panel requirements-panel">
            <span>Requirements</span>
            {mockRequirement ? <p><b>Mock/local:</b> {mockRequirement}</p> : null}
            {hardRequirements.length ? <ul>{hardRequirements.map((item) => <li>{item}</li>)}</ul> : <p><b>Live:</b> no external blockers listed</p>}
          </section>
          <section class="detail-panel">
            <span>Flexibility</span>
            <p>Use the defaults or swap parts while keeping the contracts and checks.</p>
            <ul>{flexibilityItems.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
          </section>
          <section class="detail-panel estimate-panel">
            <span>Estimate</span>
            <p><b>{implementationEstimate(bp)}</b> {estimateLabel}</p>
          </section>
        </div>

        {bp.howToUse?.length ? <>
          <h2>How to use it</h2>
          <div class="grid how-grid" aria-label="How to use this Buildprint">
            {bp.howToUse.map((step) => <section class="panel quiet">
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </section>)}
          </div>
          {bp.resultChecklist?.length ? <>
            <h2>What the agent should produce</h2>
            <ul class="verification-list" aria-label="Expected Mapper OS outputs">
              {bp.resultChecklist.map((item) => <li>{item}</li>)}
            </ul>
          </> : null}
        </> : null}

        <h2>Agent packet</h2>
        <div class="agent-packet-list" aria-label="Files the agent receives">
          {packetFiles.map((file) => <a href={`${bp.rawBaseUrl}/${file.path}`}>
            <code>{file.path}</code>
            <span>{file.purpose}</span>
          </a>)}
        </div>

        <h2>Implementation flow</h2>
        <div class="architecture-flow compact-flow flat-flow" aria-label="Implementation flow">
          {architectureFlow.map((step, index) => <>
            <span><TechName name={step} /></span>
            {index < architectureFlow.length - 1 ? <b aria-hidden="true">→</b> : null}
          </>)}
        </div>

        <h2>Validation</h2>
        <ul class="verification-list" aria-label="Validation evidence">
          {proofItems.map((item) => <li>{item}</li>)}
          {bp.status === 'validated' ? <li>validated status</li> : <li>{detailStatus}</li>}
        </ul>

        <h2>Links</h2>
        <ul>
          <li><a href={`/buildprints/${bp.slug}/package.json`}>Package JSON</a></li>
          <li><a href={`/buildprints/${bp.slug}/agent.md`}>Agent guide</a></li>
          <li><a href={bp.githubUrl}><TechName name="GitHub" /> Buildprint files</a></li>
          {bp.originGithubUrl ? <li><a href={bp.originGithubUrl} target="_blank" rel="noreferrer">Source repo: {originName}</a></li> : null}
        </ul>

        <details class="readme-details advanced-details">
          <summary>Advanced package details</summary>
          <h3>Start command</h3>
          <div class="readme-code-row">
            <code>{startCommand}</code>
            <button class="copy-inline copy-btn" data-copy={startCommand}>Copy</button>
          </div>

          <h3>All package files</h3>
          <div class="readme-file-list all-files-list">
            {bp.files.map((file) => {
              const fileUrl = `${bp.rawBaseUrl}/${file.path}`;
              const copyUrl = fileUrl.startsWith('http') ? fileUrl : `${siteBase}${fileUrl}`;
              return <div class="readme-file-item">
                <a href={fileUrl}><code>{file.path}</code></a>
                <p>{file.purpose}</p>
                <button class="copy-inline copy-btn" data-copy={copyUrl}>Copy URL</button>
              </div>;
            })}
          </div>

          <h3>Manifest preview</h3>
          <pre>{JSON.stringify({ slug: bp.slug, title: bp.title, tier: bp.tier, category: bp.category, status: bp.status, originGithub: bp.originGithubUrl, agent: manifest.entrypoints.agent, manifest: manifest.entrypoints.manifest }, null, 2)}</pre>
        </details>
      </section>
    </article>
  </main>
  <script>
    function copyText(value) {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(value);
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      return Promise.resolve();
    }

    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.setAttribute('data-label', button.textContent || 'Copy');
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-copy') || '';
        const original = button.getAttribute('data-label') || 'Copy';
        button.textContent = 'Copied ✓';
        button.classList.add('copied');
        button.setAttribute('aria-live', 'polite');
        copyText(value).catch(() => {
          button.textContent = 'Copy failed';
        });
        setTimeout(() => {
          button.textContent = original;
          button.classList.remove('copied');
        }, 2200);
      });
    });
  </script>
</BaseLayout>
