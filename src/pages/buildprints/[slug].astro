---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, getBuildprint, packageManifest, siteBase } from '@/lib/buildprints';
import { badgeIcon } from '@/lib/icons';
export function getStaticPaths() { return buildprints.map((bp) => ({ params: { slug: bp.slug } })); }
const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');
const manifest = packageManifest(bp);
const startCommand = `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const detailStatus = bp.planned || bp.status === 'coming-soon' ? 'Planned' : bp.status === 'validated' ? 'Verified' : bp.status === 'draft' ? 'Draft' : bp.checks.length ? 'Has checks' : 'Ready';
const endpoints = [
  { label: 'Agent guide', value: `${siteBase}/buildprints/${bp.slug}/agent.md`, href: `/buildprints/${bp.slug}/agent.md` },
  { label: 'Manifest JSON', value: `${siteBase}/buildprints/${bp.slug}/package.json`, href: `/buildprints/${bp.slug}/package.json` },
  { label: 'Prompt', value: `${siteBase}/buildprints/${bp.slug}/prompt.txt`, href: `/buildprints/${bp.slug}/prompt.txt` },
];
---
<BaseLayout title={`${bp.title} — Agent Buildprint`} description={bp.summary}>
  <main>
    <section class="container hero detail-hero">
      <a class="pill" href="/buildprints/">← Registry</a>
      <h1>{bp.title}</h1>
      <p class="lead">{bp.promise}</p>
      <div class="tags detail-meta"><span class="tag hot"><b>{badgeIcon(bp.category)}</b>{bp.category}</span><span class="tag"><b>{badgeIcon(bp.status)}</b>{detailStatus}</span>{bp.stack.slice(0,3).map((x) => <span class="tag">{x}</span>)}</div>
      <div class="actions"><a class="btn primary" href="#cli-start">Start with CLI</a><button class="btn copy-btn" data-copy={bp.copyPrompt}>Copy agent prompt</button><a class="btn" href={bp.githubUrl}>GitHub</a></div>
    </section>

    <section id="cli-start" class="container section detail-start">
      <div class="panel command-card">
        <div class="panel-row"><span class="eyebrow"><b>◆</b> Recommended: CLI start</span><button class="btn copy-btn" data-copy={startCommand}>Copy CLI command</button></div>
        <code class="command-line">{startCommand}</code>
        <p>Recommended path: use the CLI to fetch the exact Buildprint into <code>.buildprint/</code>. If you are already inside a coding agent, use <b>Copy agent prompt</b> instead — it tells the agent to bootstrap from this same package.</p>
      </div>
    </section>

    <section class="container section grid columns detail-readable">
      <div class="panel"><h2>What it gives you</h2>{bp.includes.length ? <ul class="clean-list">{bp.includes.map((x) => <li>{x}</li>)}</ul> : <p>Package details are still being prepared.</p>}</div>
      <div class="panel"><h2>Quality gates</h2>{bp.checks.length ? <ul class="clean-list check-list">{bp.checks.map((x) => <li>{x}</li>)}</ul> : <p>Checks will be added before this Buildprint is publishable.</p>}</div>
      <div class="panel"><h2>Prevents</h2>{bp.risks.length ? <ul class="clean-list risk-list">{bp.risks.map((x) => <li>{x}</li>)}</ul> : <p>Risk coverage will be listed with the final package.</p>}</div>
    </section>

    <section class="container section technical-appendix">
      <details class="panel">
        <summary><span><b>Technical package details</b><small>Agent endpoints, files, prompt, and manifest preview</small></span></summary>

        <div class="appendix-block endpoint-card">
          <h2>Agent endpoints</h2>
          {endpoints.map((endpoint) => <div class="endpoint-row"><a href={endpoint.href}>{endpoint.label}</a><code>{endpoint.value.replace(siteBase, '')}</code><button class="copy-inline copy-btn" data-copy={endpoint.value}>Copy</button></div>)}
        </div>

        <div class="appendix-block">
          <div class="section-head compact"><div><h2>Files and purposes</h2></div><a class="btn" href={manifest.entrypoints.manifest}>Open manifest</a></div>
          <div class="file-table">
            {bp.files.map((file) => {
              const fileUrl = `${bp.rawBaseUrl}/${file.path}`;
              return <div class="file-row">
                <code>{file.path}</code>
                <span>{file.purpose}</span>
                <div class="file-actions"><a href={fileUrl}>Open</a><button class="copy-inline copy-btn" data-copy={`${siteBase}${fileUrl}`}>Copy URL</button></div>
              </div>;
            })}
          </div>
        </div>

        <div class="appendix-block grid columns two">
          <div class="code-card">
            <div class="panel-row"><h2>Agent prompt</h2><button class="btn copy-btn" data-copy={bp.copyPrompt}>Copy agent prompt</button></div>
            <code class="code-block-text">{bp.copyPrompt}</code>
          </div>
          <div class="code-card">
            <div class="panel-row"><h2>Manifest preview</h2><button class="btn copy-btn" data-copy={JSON.stringify({ slug: bp.slug, tier: bp.tier, category: bp.category, agent: manifest.entrypoints.agent, manifest: manifest.entrypoints.manifest }, null, 2)}>Copy</button></div>
            <code class="code-block-text">{JSON.stringify({ slug: bp.slug, tier: bp.tier, category: bp.category, agent: manifest.entrypoints.agent, manifest: manifest.entrypoints.manifest }, null, 2)}</code>
          </div>
        </div>
      </details>
    </section>
  </main>
  <script>
    function copyText(value) {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(value);
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      return Promise.resolve();
    }

    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.setAttribute('data-label', button.textContent || 'Copy');
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-copy') || '';
        const original = button.getAttribute('data-label') || 'Copy';
        button.textContent = 'Copied ✓';
        button.classList.add('copied');
        button.setAttribute('aria-live', 'polite');
        copyText(value).catch(() => {
          button.textContent = 'Copy failed';
        });
        setTimeout(() => {
          button.textContent = original;
          button.classList.remove('copied');
        }, 2200);
      });
    });
  </script>
</BaseLayout>
