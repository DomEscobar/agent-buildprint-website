---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, buildprintFileText, getBuildprint, packageManifest, siteBase } from '@/lib/buildprints';

export function getStaticPaths() {
  return buildprints.map((bp) => ({ params: { slug: bp.slug } }));
}

const bp = getBuildprint(Astro.params.slug ?? '');
if (!bp) return Astro.redirect('/buildprints/');

const manifest = packageManifest(bp);
const sourceMatch = bp.githubUrl.match(/github\.com\/([^/]+)\/([^/]+)(?:\/tree\/([^/]+)\/(.+))?/);
const sourceOwner = sourceMatch?.[1] ?? 'DomEscobar';
const sourceRepo = sourceMatch ? `${sourceMatch[1]}/${sourceMatch[2]}` : 'DomEscobar/agent-buildprint';
const sourceBranch = sourceMatch?.[3] ?? 'main';
const sourcePath = sourceMatch?.[4] ?? `buildprints/${bp.slug}`;
const ownerHandle = bp.creator.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || sourceOwner.toLowerCase();
const description = bp.plainDescription ?? bp.summary;
const entrypoint = manifest.canonicalStart ?? bp.files.find((file) => file.path === 'BUILDPRINT.md')?.path ?? bp.files[0]?.path ?? 'BUILDPRINT.md';
const startCommand = manifest.bootstrap?.command ?? `agb start ${siteBase}/buildprints/${bp.slug}/package.json`;
const fallbackCommand = manifest.bootstrap?.fallbackCommand;
const copyPrompt = bp.copyPrompt || `Use the ${bp.title} Buildprint. First bootstrap exact snapshots: ${startCommand} . Then read .buildprint/next-agent.md and continue.`;
const updatedDate = bp.updatedAt ? new Date(bp.updatedAt) : null;
const updatedLabel = updatedDate && !Number.isNaN(updatedDate.getTime())
  ? updatedDate.toLocaleString('en', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'Source synced';
const readOrder = manifest.readOrder?.length ? manifest.readOrder : [entrypoint];
const readOrderFiles = readOrder.map((filePath) => bp.files.find((file) => file.path === filePath)).filter(Boolean);
const fileTree = bp.files.map((file) => ({ ...file, rawUrl: `${bp.rawBaseUrl}/${file.path}` }));
const topLevelCount = new Set(bp.files.map((file) => file.path.split('/')[0])).size;
const hasRunArtifact = Boolean(bp.proofUrl || bp.visualRun?.demoUrl);
const runRows = hasRunArtifact ? [
  {
    status: 'linked',
    label: bp.proofUrl ? 'Proof artifact' : 'Visual artifact',
    command: 'Maintainer supplied public artifact',
    output: bp.proofUrl ?? bp.visualRun?.demoUrl,
    checks: bp.checks.slice(0, 4),
  },
] : [];
const rawEntrypointUrl = `${bp.rawBaseUrl}/${entrypoint}`;
const packageUrl = `${siteBase}/buildprints/${bp.slug}/package.json`;
const agentUrl = `${siteBase}/buildprints/${bp.slug}/agent.md`;
const promptUrl = `${siteBase}/buildprints/${bp.slug}/prompt.txt`;

const typeCode = (() => {
  const haystack = `${bp.slug} ${bp.title} ${bp.summary}`.toLowerCase();
  if (haystack.includes('mapper') || haystack.includes('generator') || haystack.includes('builder')) return 'BU';
  if (bp.category === 'Product OS') return 'OS';
  if (bp.category === 'Workflow OS') return 'WF';
  if (bp.category === 'Framework / Architecture') return 'FW';
  if (bp.category === 'Feature / Extension') return 'EX';
  if (bp.category === 'Mapped Project') return 'MP';
  return bp.category.slice(0, 2).toUpperCase();
})();
const readmeText = await buildprintFileText(bp.slug, 'README.md');
const escapeHtml = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;');
const inlineMarkdown = (value: string) => escapeHtml(value)
  .replace(/`([^`]+)`/g, '<code>$1</code>')
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');
const markdownToHtml = (markdown: string) => {
  const lines = markdown.replace(/\r\n/g, '\n').split('\n');
  const html: string[] = [];
  let paragraph: string[] = [];
  let listOpen = false;
  let codeOpen = false;
  const flushParagraph = () => {
    if (!paragraph.length) return;
    html.push(`<p>${inlineMarkdown(paragraph.join(' '))}</p>`);
    paragraph = [];
  };
  const closeList = () => {
    if (listOpen) {
      html.push('</ul>');
      listOpen = false;
    }
  };
  for (const line of lines) {
    if (line.trim().startsWith('```')) {
      flushParagraph();
      closeList();
      html.push(codeOpen ? '</code></pre>' : '<pre><code>');
      codeOpen = !codeOpen;
      continue;
    }
    if (codeOpen) {
      html.push(escapeHtml(line));
      continue;
    }
    if (!line.trim()) {
      flushParagraph();
      closeList();
      continue;
    }
    const heading = line.match(/^(#{1,4})\s+(.+)$/);
    if (heading) {
      flushParagraph();
      closeList();
      const level = Math.min(heading[1].length + 1, 4);
      html.push(`<h${level}>${inlineMarkdown(heading[2])}</h${level}>`);
      continue;
    }
    const bullet = line.match(/^\s*[-*]\s+(.+)$/);
    if (bullet) {
      flushParagraph();
      if (!listOpen) {
        html.push('<ul>');
        listOpen = true;
      }
      html.push(`<li>${inlineMarkdown(bullet[1])}</li>`);
      continue;
    }
    paragraph.push(line.trim());
  }
  flushParagraph();
  closeList();
  if (codeOpen) html.push('</code></pre>');
  return html.join('\n');
};
const readmeHtml = readmeText ? markdownToHtml(readmeText) : `<p>${escapeHtml(description)}</p>`;
---
<BaseLayout title={`${bp.title} by @${ownerHandle} - Agent Buildprint`} description={description}>
  <main class="artifact-page readme-detail-page">
    <section class="artifact-hero readme-detail-hero">
      <div class="container readme-detail-top">
        <a class="artifact-back" href="/buildprints/">← Explore</a>
        <div class="readme-title-row">
          <div class="registry-hf-avatar readme-type-mark" title={bp.category} aria-label={`${bp.category} type`}>{typeCode}</div>
          <div>
            <p class="artifact-path"><span>@{ownerHandle}</span><span>/</span><strong>{bp.slug}</strong></p>
            <h1>{bp.title}</h1>
            <p class="artifact-summary">{description}</p>
          </div>
        </div>
        <div class="artifact-actions readme-action-bar">
          <button class="artifact-primary copy-btn" data-copy={startCommand}>Copy start command</button>
          <button class="copy-btn" data-copy={copyPrompt}>Copy agent prompt</button>
          <a href={agentUrl}>agent.md</a>
          <a href={packageUrl}>package.json</a>
          <a href={bp.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </section>

    <section class="container readme-detail-layout">
      <article class="readme-document" id="readme">
        <header class="readme-document-head">
          <span>README.md</span>
          <a href={`${bp.rawBaseUrl}/README.md`}>Raw</a>
        </header>
        <div class="readme-rendered" set:html={readmeHtml} />
      </article>

      <aside class="readme-side-panel" aria-label="Buildprint utility panel">
        <div class="readme-side-card use-card">
          <div class="artifact-panel-head">
            <span>Use this</span>
            <b>{entrypoint}</b>
          </div>
          <div class="artifact-command">
            <code>{startCommand}</code>
            <button class="copy-btn" data-copy={startCommand}>Copy</button>
          </div>
        </div>

        <div class="readme-side-card">
          <span class="side-label">Package facts</span>
          <dl class="artifact-quick-facts">
            <div><dt>Updated</dt><dd>{updatedLabel}</dd></div>
            <div><dt>Files</dt><dd>{bp.files.length}</dd></div>
            <div><dt>Groups</dt><dd>{topLevelCount}</dd></div>
            <div><dt>Public runs</dt><dd>{runRows.length ? 'Linked' : 'None yet'}</dd></div>
          </dl>
        </div>

        <div class="readme-side-card">
          <span class="side-label">Source</span>
          <dl class="artifact-quick-facts">
            <div><dt>Repo</dt><dd>{sourceRepo}</dd></div>
            <div><dt>Path</dt><dd>{sourcePath}</dd></div>
            <div><dt>Branch</dt><dd>{sourceBranch}</dd></div>
          </dl>
        </div>

        <details class="readme-side-card readme-files-mini">
          <summary>Files <b>{bp.files.length}</b></summary>
          <div class="artifact-file-list">
            {fileTree.map((file) => (
              <div>
                <a href={file.rawUrl}><code>{file.path}</code></a>
                <button class="copy-btn" data-copy={file.rawUrl}>Copy</button>
              </div>
            ))}
          </div>
        </details>
      </aside>
    </section>
  </main>
  <script>
    function fallbackCopy(value) {
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.inset = '0 auto auto 0';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const copied = document.execCommand('copy');
      textarea.remove();
      if (!copied) throw new Error('Copy command failed');
    }
    async function copyText(value) {
      if (navigator.clipboard?.writeText && window.isSecureContext) {
        try {
          await Promise.race([
            navigator.clipboard.writeText(value),
            new Promise((_, reject) => setTimeout(() => reject(new Error('Clipboard timeout')), 750)),
          ]);
          return;
        } catch (_) {
          // Some browser automation and locked-down contexts expose clipboard APIs that never resolve.
        }
      }
      fallbackCopy(value);
    }
    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy') || '';
        const previous = button.textContent;
        try {
          await copyText(value);
          button.textContent = 'Copied';
          button.classList.add('copied');
        } catch (_) {
          button.textContent = 'Copy failed';
          button.classList.add('copy-failed');
        }
        setTimeout(() => { button.textContent = previous; button.classList.remove('copied', 'copy-failed'); }, 1400);
      });
    });
  </script>
</BaseLayout>
