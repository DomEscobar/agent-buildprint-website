---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, categories, implementationEstimate, tiers } from '@/lib/buildprints';
import { badgeIcon, iconHtml, iconKeysForName, iconTitle } from '@/lib/icons';

const categoryTip = (bp) => `${bp.category}: ${bp.tier} Buildprint package`;
const tierLabel = (bp) => bp.tier.replace('-', ' ');
const stackIcons = (bp) => Array.from(new Set(bp.stack.flatMap((item) => iconKeysForName(item)))).slice(0, 4);
---
<BaseLayout title="Agent Buildprint Registry" description="Browse reusable Buildprints for products, features, architectures, workflows, and integrations.">
  <main>
    <section class="container hero compact-hero">
      <span class="pill"><b>⌁</b> Registry · human and agent navigable</span>
      <h1>Find a real plan before your agent writes code.</h1>
      <p class="lead">Browse reusable build plans with architecture, specs, phases, contracts, and checks — made for humans to inspect and agents to follow.</p>
      <div class="actions"><a class="btn primary" href="#cards">Browse cards</a><a class="btn" href="/why-buildprints/">Why Buildprints?</a><a class="btn" href="/buildprints/index.json">Registry JSON</a></div>
    </section>

    <section class="container section registry-tools">
      <input id="search" class="searchbar" placeholder="Search OpenClaw, Stripe, workflow, agent-grade..." />
      <div class="filter-row">
        <div><span class="filter-label">Category</span><div class="tags" id="filters">{categories.map((category) => <button class="tag filter" data-category={category}><b>{badgeIcon(category)}</b>{category}</button>)}</div></div>
        <div><span class="filter-label">Tier</span><div class="tags" id="tierFilters">{tiers.map((tier) => <button class="tag filter" data-tier={tier}><b>{badgeIcon(tier)}</b>{tier}</button>)}</div></div>
      </div>
      <div class="grid cards" id="cards">
        {buildprints.map((bp) => (
          <a class="card buildprint-card clickable-card" href={`/buildprints/${bp.slug}/`} data-category={bp.category} data-tier={bp.tier} data-search={`${bp.title} ${bp.creator} ${bp.category} ${bp.tier} ${bp.runtime.join(' ')} ${bp.stack.join(' ')} ${bp.summary}`.toLowerCase()}>
            <div class="card-body">
              <div class="card-topline"><span class="plain-category" title={categoryTip(bp)}><b>{badgeIcon(bp.category)}</b>{bp.category}</span><span class="status-word" title={`${bp.tier} package`}>{tierLabel(bp)}</span></div>
              <h3>{bp.title}</h3>
              <p>{bp.summary}</p>
              <div class="card-tech-footer" title={bp.stack.join(' · ')}><span>{bp.stack.slice(0, 3).join(' · ')}</span><span class="card-tech-side"><em>{implementationEstimate(bp)}</em><span class="tiny-tech-icons" aria-hidden="true">{stackIcons(bp).map((key) => <i title={iconTitle[key] ?? key} set:html={iconHtml(key)} />)}</span></span></div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <script>
    const search = document.querySelector('#search');
    const cards = Array.from(document.querySelectorAll('.buildprint-card'));
    const buttons = Array.from(document.querySelectorAll('#filters button'));
    const tierButtons = Array.from(document.querySelectorAll('#tierFilters button'));
    let active = 'All';
    let activeTier = 'All';
    function apply() {
      const q = (search?.value || '').toLowerCase();
      for (const card of cards) {
        const categoryOk = active === 'All' || card.dataset.category === active;
        const tierOk = activeTier === 'All' || card.dataset.tier === activeTier;
        const searchOk = !q || card.dataset.search?.includes(q);
        card.classList.toggle('hidden', !(categoryOk && tierOk && searchOk));
      }
    }
    function markActive(group, value, key) {
      group.forEach((button) => button.classList.toggle('active', (button.dataset[key] || 'All') === value));
    }
    buttons.forEach((b) => b.addEventListener('click', () => { active = b.dataset.category || 'All'; markActive(buttons, active, 'category'); apply(); }));
    tierButtons.forEach((b) => b.addEventListener('click', () => { activeTier = b.dataset.tier || 'All'; markActive(tierButtons, activeTier, 'tier'); apply(); }));
    search?.addEventListener('input', apply);
    document.querySelectorAll('.copy').forEach((b) => b.addEventListener('click', async () => { await navigator.clipboard.writeText(b.dataset.prompt || ''); b.textContent = 'Copied'; setTimeout(() => b.textContent = 'Copy prompt', 1000); }));
  </script>
</BaseLayout>
