---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { implementationEstimate, liveBuildprints } from '@/lib/buildprints';
import { iconHtml, iconKeysForName, iconTitle } from '@/lib/icons';
import TechName from '@/components/TechName.astro';

const featured = liveBuildprints.filter((bp) => bp.featured).slice(0, 4);
const isWorkflow = (bp) => bp.category === 'Workflow OS';
const cardVerb = (bp) => isWorkflow(bp) ? 'Produces' : 'Builds';
const cardAgentLabel = (bp) => isWorkflow(bp) ? 'Agent uses' : 'Agent receives';
const cardEstimateSuffix = (bp) => isWorkflow(bp) ? 'workflow pass' : 'implementation pass';
const packetParts = [
  { code: '01', label: 'Start file', detail: 'One canonical entry point tells the agent what to read first and what not to invent.' },
  { code: '02', label: 'Phase flow', detail: 'Small executable slices with context, review loops, repair routes, and stop conditions.' },
  { code: '03', label: 'Evidence rules', detail: 'Proof and blockers are recorded separately from the spec; claims upgrade only with valid evidence.' },
];
const agentReceives = ['Router', 'Intent', 'Context', 'Capability', 'Evaluation', 'Evidence'];
const fixedRails = ['Canonical start path', 'Scope and obligations', 'Context/read order', 'Capability proof contracts', 'Evidence ledger'];
const adaptableParts = ['Stack', 'Providers', 'UI', 'Database/storage', 'Deployment target'];
const proofItems = ['Bootstrap snapshot passed', 'Router/read order clear', 'Proof contracts present', 'Evidence/blockers recorded'];

const trustLabel = (bp) => {
  if (bp.publicStatus?.label) return bp.publicStatus.label;
  if (bp.status === 'validated') return 'Validated';
  if (bp.checks.length > 0) return 'Checked';
  return 'Ready';
};
const trustTip = (bp) => {
  if (bp.publicStatus?.explanation) return bp.publicStatus.explanation;
  if (bp.status === 'validated') return 'Validated by snapshot bootstrap, dry-run/tests, and documented proof.';
  if (bp.checks.length > 0) return 'Has defined quality checks, but still needs full dry-run validation.';
  return 'Ready to inspect.';
};
const cardCopy = (bp) => bp.plainDescription ?? bp.summary;
const practicalNeed = (bp) => {
  const needs = bp.whatYouNeed ?? [];
  const noLocalBlocker = needs.find((need) => /^Nothing/i.test(need));
  const externalBlocker = needs.find((need) => !/^Nothing/i.test(need));
  if (noLocalBlocker && externalBlocker) return 'Local/mock mode has no external blocker. Real use needs configured keys, accounts, or repo access.';
  if (noLocalBlocker) return 'Local/mock mode has no external blocker.';
  return externalBlocker ?? 'Bring the target repo, product decisions, and any required external credentials.';
};
const stackIcons = (bp) => Array.from(new Set(bp.stack.flatMap((item) => iconKeysForName(item)))).slice(0, 4);
---
<BaseLayout title="Agent Buildprint - plans before AI writes code" description="Executable implementation plans for coding agents. Give Codex, Cursor, Claude Code, and other agents architecture, phases, contracts, requirements, and checks before they write code.">
  <main>
    <section class="container hero clean-hero platform-hero usp-hero">
      <div class="hero-copy">
        <span class="pill dossier-pill"><b>The planning layer before AI writes code</b></span>
        <h1>Stop asking agents to improvise your architecture.</h1>
        <p class="lead">Buildprints turn reusable implementation knowledge — and repo-mapping workflows — into packets an agent can bootstrap, follow, and prove.</p>
        <div class="agent-compat" aria-label="Compatible coding agents">
          <span>Works with</span>
          <TechName name="Codex" />
          <TechName name="Cursor" />
          <TechName name="Claude Code" />
        </div>
        <div class="actions">
          <a class="btn primary" href="/buildprints/">Browse Buildprints</a>
          <a class="btn" href="#how-it-works">See how one works</a>
        </div>
        <div class="hero-trust-strip" aria-label="Agent Buildprint trust markers">
          <span><b>START</b> One router</span>
          <span><b>CAP</b> Capability packets</span>
          <span><b>EVID</b> Evidence required</span>
          <span><b>AGENT</b> Codex / Cursor / Claude-ready</span>
        </div>
      </div>

      <aside class="split-rail-diagram" aria-label="Prompt-only workflow compared with Buildprint workflow">
        <div class="workbench-topline"><span>Buildprint workbench</span><b>before code</b></div>
        <div class="rail-column rail-bad">
          <span class="rail-kicker">Prompt only</span>
          <div class="rail-node">"Build me an AI blog system"</div>
          <div class="rail-arrow" aria-hidden="true"></div>
          <div class="rail-node muted">Agent guesses architecture while coding</div>
          <div class="rail-arrow" aria-hidden="true"></div>
          <div class="rail-result bad">Drift, rework, forgotten gates</div>
        </div>
        <div class="rail-column rail-good">
          <span class="rail-kicker">With Buildprint</span>
          <div class="packet-stack" aria-label="Layered Buildprint packet">
            <div class="packet-shadow packet-shadow-one">START</div>
            <div class="packet-shadow packet-shadow-two">INTENT</div>
            <div class="packet-shadow packet-shadow-three">CONTEXT</div>
            <div class="packet-shadow packet-shadow-four">EVIDENCE</div>
            <div class="rail-node strong">Buildprint packet</div>
          </div>
          <span class="validated-stamp">Validated</span>
          <div class="rail-packet-list">
            {agentReceives.map((part) => <span>{part}</span>)}
          </div>
          <div class="rail-arrow" aria-hidden="true"></div>
          <div class="rail-result good">Agent follows rails. Human reviews evidence.</div>
        </div>
        <div class="evidence-receipt" aria-label="Evidence receipt">
          <span>Evidence receipt</span>
          <div><b>bootstrap</b><em>passed</em></div>
          <div><b>files</b><em>available</em></div>
          <div><b>tests</b><em>recorded</em></div>
          <div><b>boundaries</b><em>documented</em></div>
        </div>
      </aside>
    </section>

    <section id="how-it-works" class="container section packet-section" aria-labelledby="packet-title">
      <div class="section-head proof-head">
        <div>
          <span class="eyebrow"><b>01</b> What a Buildprint contains</span>
          <h2 id="packet-title">A handoff packet, not another prompt template.</h2>
        </div>
        <p>Each modern Buildprint is an executable packet: start here, run these phases, prove these claims. No scavenger hunt through prompt prose.</p>
      </div>
      <div class="handoff-packet" aria-label="Buildprint handoff packet">
        <div class="handoff-main">
          <b>Like an npm package for agent work.</b>
          <p>Reusable, bootstrappable, and strict about what counts as done.</p>
        </div>
        <div class="handoff-steps">
          {packetParts.map((part) => <div class="handoff-step">
            <span>{part.code}</span>
            <div><b>{part.label}</b><small>{part.detail}</small></div>
          </div>)}
        </div>
      </div>
    </section>

    <section class="container section rails-section" aria-labelledby="rails-title">
      <div class="section-head simple">
        <div>
          <span class="eyebrow"><b>02</b> Control</span>
          <h2 id="rails-title">Rails, not handcuffs.</h2>
          <p>Use the defaults or swap parts. The router, capability packets, and evidence ledger keep the work scoped and testable.</p>
        </div>
      </div>
      <div class="rails-grid">
        <div class="rails-panel fixed">
          <span>Fixed by the plan</span>
          <ul>{fixedRails.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="rails-panel adapt">
          <span>Adaptable by the builder</span>
          <ul>{adaptableParts.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="container section featured-dossiers" aria-labelledby="featured-title">
      <div class="section-head simple">
        <div>
          <span class="eyebrow"><b>03</b> Featured</span>
          <h2 id="featured-title">Pick the right packet before your agent starts.</h2>
        </div>
        <a class="link" href="/buildprints/">View registry</a>
      </div>
      <div class="grid cards featured-grid dossier-grid">
        {featured.map((bp) => <a class="mini-card clickable-card dossier-card" href={`/buildprints/${bp.slug}/`}>
          <div class="dossier-card-topline">
            <span>{bp.category}</span>
            <b title={trustTip(bp)}>{trustLabel(bp)}</b>
          </div>
          <h3>{bp.title}</h3>
          <p><strong>{cardVerb(bp)}:</strong> {cardCopy(bp)}</p>
          <p><strong>Needs:</strong> {practicalNeed(bp)}</p>
          <div class="agent-receives" aria-label={`${bp.title} agent packet`}>
            <span>{cardAgentLabel(bp)}</span>
            <div>{agentReceives.map((part) => <em>{part}</em>)}</div>
          </div>
          <div class="card-tech-footer" title={bp.stack.join(' / ')}>
            <span>{bp.stack.slice(0, 3).join(' / ')}</span>
            <span class="card-tech-side"><em>{implementationEstimate(bp)} {cardEstimateSuffix(bp)}</em><span class="tiny-tech-icons" aria-hidden="true">{stackIcons(bp).map((key) => <i title={iconTitle[key] ?? key} set:html={iconHtml(key)} />)}</span></span>
          </div>
        </a>)}
      </div>
    </section>

    <section class="container section evidence-section" aria-labelledby="evidence-title">
      <div class="evidence-band">
        <div>
          <span class="eyebrow"><b>04</b> Proof</span>
          <h2 id="evidence-title">Validated means evidence.</h2>
          <p>Trust is not a badge alone. A validated Buildprint leaves inspectable proof that the package can be bootstrapped, read, tested, and bounded.</p>
        </div>
        <div class="evidence-list">
          {proofItems.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </section>

    <section class="container section how-section">
      <div class="section-head simple">
        <div>
          <span class="eyebrow"><b>05</b> Use it</span>
          <h2>Give your agent the packet, then make it prove the work.</h2>
        </div>
      </div>
      <div class="grid how-grid">
        <div class="panel quiet"><span class="step-number">1</span><h3>Choose a Buildprint</h3><p>Pick the product, feature, workflow, architecture, or repo-mapping packet you want the agent to run.</p></div>
        <div class="panel quiet"><span class="step-number">2</span><h3>Bootstrap or copy it</h3><pre>npx --yes github:DomEscobar/agent-buildprint start https://agent-buildprint.com/buildprints/ai-influencer-os/package.json</pre></div>
        <div class="panel quiet"><span class="step-number">3</span><h3>Agent follows phases</h3><p>Tell <TechName name="Codex" />, <TechName name="Cursor" />, or <TechName name="Claude Code" /> to follow the package, not improvise from a vague prompt.</p></div>
        <div class="panel quiet"><span class="step-number">4</span><h3>Review the evidence</h3><p>The agent runs the proof contracts, reports blockers, and appends evidence you can inspect before you call the work done.</p></div>
      </div>
    </section>

    <section class="container section two-col secondary-paths">
      <div class="panel quiet">
        <span class="eyebrow"><b>Mapper</b></span>
        <h2>Already have a repo?</h2>
        <p>Use Mapper OS to map a working repo, produce scoped Buildprint candidates, choose one, and extract a source-independent executable packet with proof gates.</p>
        <pre>Map repo
Select candidate
Extract packet
Record proof/blockers</pre>
      </div>
      <div class="panel quiet">
        <span class="eyebrow"><b>Publish</b></span>
        <h2>Have an architecture worth reusing?</h2>
        <p>Package the router, intent, context, capability packets, evaluation gates, and evidence rules so other builders can give agents an executable work contract instead of a wish.</p>
        <pre>Router
Intent
Capability packets
Evaluation gates
Evidence ledger</pre>
      </div>
    </section>
  </main>
</BaseLayout>
