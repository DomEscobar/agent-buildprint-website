---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, categories, tiers } from '@/lib/buildprints';
import { badgeIcon } from '@/lib/icons';

const categoryTip = (bp) => `${bp.category}: ${bp.tier} Buildprint package`;
const tierLabel = (bp) => bp.tier.replace('-', ' ');
const hasProofArtifacts = (bp) => bp.files.some((file) => file.path.startsWith('proof/') || file.path.includes('evidence') || file.path.includes('acceptance'));
const proofCount = buildprints.filter(hasProofArtifacts).length;
const validatedCount = buildprints.filter((bp) => bp.status === 'validated').length;
const agentGradeCount = buildprints.filter((bp) => bp.tier === 'agent-grade').length;
const mapperBuildprint = buildprints.find((bp) => bp.slug === 'buildprint-mapper-os');
const featuredBuildprints = [
  mapperBuildprint,
  ...buildprints
    .filter((bp) => bp.slug !== 'buildprint-mapper-os')
  .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured))
    || Number(b.status === 'validated') - Number(a.status === 'validated')
      || Number(b.tier === 'agent-grade') - Number(a.tier === 'agent-grade')),
]
  .filter((bp): bp is typeof buildprints[number] => Boolean(bp))
  .slice(0, 3);
const outcomeLine = (bp) => bp.promise || bp.plainDescription || bp.summary;
const proofLine = (bp) => bp.publicStatus?.label ?? bp.status.replace('-', ' ');
const updatedDate = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
const updatedLabel = (bp) => {
  if (!bp.updatedAt) return 'Updated date unknown';
  const date = new Date(bp.updatedAt);
  return Number.isNaN(date.getTime()) ? 'Updated date unknown' : `Updated ${updatedDate.format(date)}`;
};
---
<BaseLayout title="Agent Buildprint Registry" description="Browse reusable Buildprints for products, features, architectures, workflows, and integrations.">
  <main class="registry-overview">
    <section class="container registry-hero">
      <div class="registry-hero-mark" aria-hidden="true">
        <img src="/logo.svg" alt="" />
      </div>
      <div class="registry-hero-copy">
        <span class="registry-eyebrow">Buildprint registry</span>
        <h1>Choose the thing your agent should build.</h1>
        <p class="lead">Browse reusable product, workflow, architecture, and extension packets by outcome, scope, proof boundary, and handoff readiness.</p>
        <div class="actions"><a class="btn primary" href="#cards">Browse Buildprints</a><a class="btn" href="/why-buildprints/">Why Buildprints?</a><a class="btn" href="/buildprints/index.json">Registry JSON</a></div>
      </div>
      <aside class="registry-hero-panel" aria-label="Registry snapshot">
        <div class="registry-hero-stat"><span>{buildprints.length}</span><b>published packets</b></div>
        <div class="registry-hero-stat"><span>{agentGradeCount}</span><b>agent-grade</b></div>
        <div class="registry-hero-stat"><span>{validatedCount}</span><b>validated</b></div>
        <div class="registry-hero-stat"><span>{proofCount}</span><b>with proof files</b></div>
      </aside>
    </section>

    <section class="container registry-featured" aria-label="Featured Buildprints">
      <div class="registry-section-head">
        <span>Recommended first reads</span>
      </div>
      <div class="registry-featured-grid">
        {featuredBuildprints.map((bp, index) => (
          <a class={`registry-feature-card ${bp.slug === 'buildprint-mapper-os' ? 'is-golden' : ''}`} href={`/buildprints/${bp.slug}/`} data-engagement-card data-slug={bp.slug}>
            <small>{bp.slug === 'buildprint-mapper-os' ? 'Golden Buildprint' : index === 1 ? 'Strong packet' : 'Worth inspecting'}</small>
            <div class="registry-feature-meta"><span>{badgeIcon(bp.category)} {bp.category}</span><b>{proofLine(bp)}</b></div>
            <h3>{bp.title}</h3>
            <p>{outcomeLine(bp)}</p>
            <div class="registry-card-engagement" aria-label="Buildprint engagement"><span><b data-card-views>--</b> views</span><span><b data-card-likes>--</b> likes</span><time datetime={bp.updatedAt}>{updatedLabel(bp)}</time></div>
          </a>
        ))}
      </div>
    </section>

    <section class="container section registry-tools" aria-label="Buildprint registry browser">
      <div class="registry-toolbar">
        <div>
          <span class="filter-label">Search registry</span>
          <input id="search" class="searchbar" placeholder="Search outcome, product, provider, stack..." />
        </div>
        <p id="resultCount" aria-live="polite">Showing {buildprints.length} Buildprints</p>
      </div>
      <div class="filter-row registry-filter-row">
        <div><span class="filter-label">Category</span><div class="tags" id="filters">{categories.map((category) => <button class="tag filter" data-category={category}><b>{badgeIcon(category)}</b>{category}</button>)}</div></div>
        <div><span class="filter-label">Tier</span><div class="tags" id="tierFilters">{tiers.map((tier) => <button class="tag filter" data-tier={tier}><b>{badgeIcon(tier)}</b>{tier}</button>)}</div></div>
      </div>
      <div class="registry-card-grid" id="cards">
        {buildprints.map((bp) => (
          <a class={`card buildprint-card registry-card clickable-card ${bp.status === 'validated' ? 'is-validated' : ''} ${bp.tier === 'agent-grade' ? 'is-agent-grade' : ''}`} href={`/buildprints/${bp.slug}/`} data-engagement-card data-slug={bp.slug} data-category={bp.category} data-tier={bp.tier} data-search={`${bp.title} ${bp.creator} ${bp.category} ${bp.tier} ${bp.runtime.join(' ')} ${bp.stack.join(' ')} ${bp.summary} ${outcomeLine(bp)} ${proofLine(bp)}`.toLowerCase()}>
            <div class="card-body">
              <div class="card-topline"><span class="plain-category" title={categoryTip(bp)}><b>{badgeIcon(bp.category)}</b>{bp.category}</span><span class="status-word" title={`${bp.tier} package`}>{tierLabel(bp)}</span></div>
              <h3>{bp.title}</h3>
              <p>{outcomeLine(bp)}</p>
              <div class="registry-card-engagement" aria-label="Buildprint engagement"><span><b data-card-views>--</b> views</span><span><b data-card-likes>--</b> likes</span><time datetime={bp.updatedAt}>{updatedLabel(bp)}</time></div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <script>
    const search = document.querySelector('#search');
    const cards = Array.from(document.querySelectorAll('.buildprint-card'));
    const buttons = Array.from(document.querySelectorAll('#filters button'));
    const tierButtons = Array.from(document.querySelectorAll('#tierFilters button'));
    const resultCount = document.querySelector('#resultCount');
    let active = 'All';
    let activeTier = 'All';
    function apply() {
      const q = (search?.value || '').toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const categoryOk = active === 'All' || card.dataset.category === active;
        const tierOk = activeTier === 'All' || card.dataset.tier === activeTier;
        const searchOk = !q || card.dataset.search?.includes(q);
        const isVisible = categoryOk && tierOk && searchOk;
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visible += 1;
      }
      if (resultCount) resultCount.textContent = `Showing ${visible} Buildprint${visible === 1 ? '' : 's'}`;
    }
    function markActive(group, value, key) {
      group.forEach((button) => button.classList.toggle('active', (button.dataset[key] || 'All') === value));
    }
    buttons.forEach((b) => b.addEventListener('click', () => { active = b.dataset.category || 'All'; markActive(buttons, active, 'category'); apply(); }));
    tierButtons.forEach((b) => b.addEventListener('click', () => { activeTier = b.dataset.tier || 'All'; markActive(tierButtons, activeTier, 'tier'); apply(); }));
    search?.addEventListener('input', apply);
    apply();

    const numberFormat = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
    document.querySelectorAll('[data-engagement-card][data-slug]').forEach(async (card) => {
      const slug = card.getAttribute('data-slug');
      const views = card.querySelector('[data-card-views]');
      const likes = card.querySelector('[data-card-likes]');
      if (!slug || !views || !likes) return;
      try {
        const response = await fetch(`/api/buildprints/${encodeURIComponent(slug)}/engagement`);
        if (!response.ok) throw new Error('engagement_unavailable');
        const payload = await response.json();
        views.textContent = numberFormat.format(payload.views || 0);
        likes.textContent = numberFormat.format(payload.likes || 0);
      } catch {
        views.textContent = '-';
        likes.textContent = '-';
      }
    });
  </script>
</BaseLayout>
