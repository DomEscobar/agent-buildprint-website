---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, liveBuildprints } from '@/lib/buildprints';
import { badgeIcon, iconHtml as icon } from '@/lib/icons';
const featured = liveBuildprints.filter((bp) => bp.featured).slice(0, 4);
const trustLabel = (bp) => {
  if (bp.planned || bp.status === 'coming-soon') return 'PLANNED';
  if (bp.status === 'validated') return 'PASSED';
  if (bp.status === 'draft') return 'DRAFT';
  if (bp.checks.length > 0) return 'CHECKED';
  return 'READY';
};
const trustTip = (bp) => {
  if (bp.planned || bp.status === 'coming-soon') return 'Planned Buildprint; package details are not ready yet.';
  if (bp.status === 'validated') return 'Validated by snapshot bootstrap, Codex dry-run, local tests, and gated publishing checks.';
  if (bp.status === 'draft') return 'Draft Buildprint; useful for review but not fully validated.';
  if (bp.checks.length > 0) return 'Has defined quality checks, but still needs full dry-run validation.';
  return 'Ready to inspect.';
};
const categoryTip = (bp) => `${bp.category}: ${bp.tier} Buildprint package`;
const sections = [
  { title: 'Product OS', items: buildprints.filter((bp) => bp.category === 'Product OS').slice(0, 5) },
  { title: 'Features & Extensions', items: buildprints.filter((bp) => bp.category === 'Feature / Extension').slice(0, 5) },
  { title: 'Framework Blueprints', items: buildprints.filter((bp) => bp.category === 'Framework / Architecture').slice(0, 5) },
  { title: 'Workflow OS', items: buildprints.filter((bp) => bp.category === 'Workflow OS').slice(0, 5) },
];
---
<BaseLayout title="Agent Buildprint — build plans agents can follow" description="Agent-readable Buildprints for frameworks, products, features, workflows, and mapped repositories.">
  <main>
    <section class="container hero clean-hero">
      <div class="hero-copy">
        <span class="pill"><b>⌁</b> agent-readable registry</span>
        <h1>Build plans agents can follow.</h1>
        <p class="lead">Buildprints package architecture, specs, phase plans, contracts, and tests into implementation plans coding agents can fetch, snapshot, continue, and validate.</p>
        <div class="actions">
          <a class="btn primary" href="/buildprints/">Browse Buildprints</a>
          <a class="btn" href="/llms.txt">Agent endpoints</a>
        </div>
      </div>
      <div class="hero-panel">
        <div class="panel-title"><span>agent bootstrap</span><b>.buildprint/</b></div>
        <pre>agb start https://agent-buildprint.com/buildprints/ai-influencer-os/package.json

✓ exact snapshots
✓ state.json
✓ next-agent.md</pre>
      </div>
    </section>

    <section class="container agent-strip">
      <div><b>Agent path</b><span>Fetch endpoints instead of scraping cards.</span></div>
      <code>/llms.txt</code><code>/buildprints/index.json</code><code>/agent.md</code><code>/package.json</code><code>agb start …</code>
    </section>

    <section class="container section visual-proof-section" aria-labelledby="visual-proof-title">
      <div class="section-head simple proof-head"><div><span class="eyebrow"><b>↯</b> Why Buildprints</span><h2 id="visual-proof-title">Stop shipping from vibes.</h2><p>Prompting asks the model to invent the plan. Buildprinting gives the agent a contract it can resume, verify, and hand off.</p></div></div>
      <div class="proof-layout">
        <div class="proof-compare" aria-label="Prompt versus Buildprint comparison">
          <div class="proof-card bad">
            <span class="proof-label">Prompt</span>
            <code>“Build me an AI blog OS”</code>
            <ul>
              <li>agent guesses architecture</li>
              <li>hidden workflows get skipped</li>
              <li>context disappears between runs</li>
              <li>validation is an afterthought</li>
            </ul>
          </div>
          <div class="proof-vs">vs</div>
          <div class="proof-card good">
            <span class="proof-label">Buildprint</span>
            <code>agb start …/package.json</code>
            <ul>
              <li>exact snapshots</li>
              <li>specs, contracts, phase plans</li>
              <li>resumable <code>next-agent.md</code></li>
              <li>tests, gates, dry-run proof</li>
            </ul>
          </div>
        </div>
        <div class="proof-folder" aria-label="Buildprint folder tree">
          <div class="terminal-top"><span></span><span></span><span></span><b>.buildprint/</b></div>
          <pre><span class="muted">.buildprint/</span>
├─ snapshots/
│  ├─ BUILDPRINT.md   <em>architecture</em>
│  ├─ SPEC.md         <em>behavior</em>
│  ├─ PLAN.md         <em>execution</em>
│  └─ TEST_MATRIX.md  <em>failure checks</em>
├─ source.json        <em>package origin</em>
├─ state.json         <em>current phase</em>
├─ progress.md        <em>what changed</em>
└─ next-agent.md      <em>handoff</em></pre>
        </div>
      </div>
      <div class="proof-flow" aria-label="Buildprint flow">
        <span>Product intent</span><b>→</b><span>Buildprint package</span><b>→</b><span>Agent bootstrap</span><b>→</b><span>Validated implementation</span>
      </div>
    </section>

    <section class="container section">
      <div class="section-head simple"><div><span class="eyebrow"><b>★</b> Featured</span><h2>Start from a Buildprint</h2></div><a class="link" href="/buildprints/">View registry →</a></div>
      <div class="grid cards featured-grid">
        {featured.map((bp) => <a class="mini-card clickable-card" href={`/buildprints/${bp.slug}/`}>
          <div class="card-topline"><span class="plain-category" title={categoryTip(bp)}><b>{badgeIcon(bp.category)}</b>{bp.category}</span><span class="status-word" title={trustTip(bp)}>{trustLabel(bp)}</span></div>
          <h3>{bp.title}</h3>
          <p>{bp.summary}</p>
          <div class="stack-row"><span class="stack-line" title={bp.stack.join(' · ')}>{bp.stack.slice(0, 3).join(' · ')}</span><span class="stack-icons" aria-label={`Stack icons: ${(bp.iconKeys ?? []).join(', ')}`}>{(bp.iconKeys ?? []).slice(0,3).map((key) => <i class={`tech-icon ${key}`} title={key} set:html={icon(key)} />)}</span></div>
        </a>)}
      </div>
    </section>

    <section class="container section rows">
      {sections.map((section) => <div class="catalog-row">
        <div class="row-head"><h2>{section.title}</h2><a class="link" href="/buildprints/">Explore →</a></div>
        <div class="row-scroll">
          {section.items.map((bp) => <a class={`row-card ${bp.planned ? 'muted-card' : ''}`} href={bp.planned ? '/buildprints/' : `/buildprints/${bp.slug}/`}>
            <div class="row-top"><span><b>{badgeIcon(bp.category)}</b>{bp.category}</span><span class="row-status"><b>{badgeIcon(bp.status)}</b>{trustLabel(bp)}</span></div>
            <b>{bp.title}</b>
            <p>{bp.summary}</p>
            <small>{bp.stack.slice(0, 3).join(' · ')}</small>
          </a>)}
        </div>
      </div>)}
    </section>

    <section class="container section how-section">
      <div class="section-head simple"><div><span class="eyebrow"><b>◆</b> How to use</span><h2>Give Codex, Cursor, or Claude Code a real construction plan.</h2></div></div>
      <div class="grid how-grid">
        <div class="panel quiet"><span class="step-number">1</span><h3>Fetch the package</h3><pre>npx --yes github:DomEscobar/agent-buildprint start https://agent-buildprint.com/buildprints/ai-influencer-os/package.json</pre></div>
        <div class="panel quiet"><span class="step-number">2</span><h3>Or use installed CLI</h3><pre>agb start https://agent-buildprint.com/buildprints/automated-ai-blog-os/package.json</pre></div>
        <div class="panel quiet"><span class="step-number">3</span><h3>Hand off to your agent</h3><p>Tell Codex, Cursor, or Claude Code: “Read <code>.buildprint/next-agent.md</code> and continue.” Keep snapshots as source-of-truth contracts.</p></div>
      </div>
    </section>

    <section class="container section two-col">
      <div class="panel quiet"><span class="eyebrow"><b>⌁</b> Mapper</span><h2>Have a repo already?</h2><p>Generate an observed Buildprint package from an existing project. Facts first, unknowns as questions, no secret values copied.</p><pre>agb map ./my-project</pre></div>
      <div class="panel quiet"><span class="eyebrow"><b>✓</b> Validated packages</span><h2>Start with continuity.</h2><p><code>agb start</code> downloads exact Buildprint snapshots and creates <code>.buildprint/next-agent.md</code> so another agent can continue after interruption.</p><pre>agb start https://agent-buildprint.com/buildprints/ai-influencer-os/package.json</pre></div>
    </section>
  </main>
</BaseLayout>
