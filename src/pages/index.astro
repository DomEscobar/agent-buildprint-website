---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, siteBase } from '@/lib/buildprints';

const updatedDate = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
const updatedLabel = (value?: string) => {
  if (!value) return 'Source synced';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? 'Source synced' : updatedDate.format(date);
};
const publishedLabel = (value?: string) => {
  const label = updatedLabel(value);
  return label === 'Source synced' ? label : `Last published ${label}`;
};
const sourceParts = (href: string) => {
  const match = href.match(/github\.com\/([^/]+\/[^/]+)(?:\/tree\/([^/]+)\/(.+))?/);
  return {
    repo: match?.[1] ?? 'DomEscobar/agent-buildprint',
    branch: match?.[2] ?? 'main',
    sourcePath: match?.[3] ?? '',
  };
};
const cards = buildprints.map((bp) => {
  const source = sourceParts(bp.githubUrl);
  const entrypoint = bp.files.find((file) => file.path === 'BUILDPRINT.md')?.path ?? bp.files[0]?.path ?? 'BUILDPRINT.md';
  const hasReview = bp.files.some((file) => file.path === '04-review.md' || file.path.includes('review'));
  const hasRuns = Boolean(bp.proofUrl || bp.visualRun?.demoUrl);
  const bootstrapReady = bp.files.some((file) => file.path === entrypoint) && Boolean(bp.copyPrompt);
  return { bp, source, entrypoint, hasReview, hasRuns, bootstrapReady };
});
const recentCards = [...cards].sort((a, b) => new Date(b.bp.updatedAt ?? 0).getTime() - new Date(a.bp.updatedAt ?? 0).getTime());
const topCards = recentCards.slice(0, 4);
const sourceCount = new Set(cards.map((card) => card.source.repo)).size;
const runnableCount = cards.filter((card) => card.bootstrapReady).length;
---
<BaseLayout title="Agent Buildprint Registry" description="Explore GitHub-backed Buildprints by source, usage, files, and execution facts.">
  <main class="registry-v2">
    <section class="registry-v2-hero">
      <div class="container registry-v2-hero-grid">
        <div class="registry-v2-copy">
          <p class="registry-v2-kicker">Agent Buildprint Registry</p>
          <h1>GitHub-backed instructions for serious coding agents.</h1>
          <p class="registry-v2-lede">Browse Buildprints by source, entrypoint, usage command, files, and execution history. No methodology lock-in. No decorative badges. Just the facts needed to decide whether an agent should run it.</p>
          <div class="registry-v2-actions">
            <a class="registry-v2-primary" href="#registry-list">Explore registry</a>
            <a href={`${siteBase}/buildprints/index.json`}>Registry JSON</a>
          </div>
        </div>
        <aside class="registry-v2-console" aria-label="Registry facts">
          <div><span>Published</span><strong>{buildprints.length}</strong></div>
          <div><span>Source repos</span><strong>{sourceCount}</strong></div>
          <div><span>Copy-ready</span><strong>{runnableCount}</strong></div>
          <div><span>Contract</span><strong>Free-form</strong></div>
        </aside>
      </div>
    </section>

    <section class="container registry-v2-strip" aria-label="Recently synced Buildprints">
      <div class="registry-v2-section-head">
        <div>
          <span>Recently synced</span>
          <h2>Fresh artifacts from GitHub</h2>
        </div>
        <p>Every card links back to source and exposes the exact bootstrapping entrypoint.</p>
      </div>
      <div class="registry-v2-feature-grid">
        {topCards.map(({ bp, source, entrypoint, bootstrapReady, hasRuns }) => (
          <a class="registry-v2-feature" href={`/buildprints/${bp.slug}/`} data-engagement-card data-slug={bp.slug}>
            <small>{source.repo}</small>
            <h3>{bp.title}</h3>
            <p>{bp.summary}</p>
            <dl>
              <div><dt>Entrypoint</dt><dd>{entrypoint}</dd></div>
              <div><dt>Published</dt><dd>{updatedLabel(bp.updatedAt)}</dd></div>
              <div><dt>Views</dt><dd data-card-views>--</dd></div>
              <div><dt>Likes</dt><dd data-card-likes>--</dd></div>
              <div><dt>Bootstrap</dt><dd>{bootstrapReady ? 'Configured' : 'Needs manifest review'}</dd></div>
              <div><dt>Runs</dt><dd>{hasRuns ? 'Public artifacts linked' : 'No public runs yet'}</dd></div>
            </dl>
          </a>
        ))}
      </div>
    </section>

    <section class="container registry-v2-browser" id="registry-list">
      <div class="registry-v2-toolbar">
        <label>
          <span>Search</span>
          <input id="search" placeholder="Search title, source, entrypoint, runtime, stack..." />
        </label>
        <p id="resultCount">Showing {cards.length} Buildprints</p>
      </div>

      <div class="registry-v2-table" role="list">
        {cards.map(({ bp, source, entrypoint, bootstrapReady, hasRuns }) => (
          <a class="registry-v2-row" href={`/buildprints/${bp.slug}/`} role="listitem" data-engagement-card data-slug={bp.slug} data-search={`${bp.title} ${bp.summary} ${bp.creator} ${source.repo} ${source.sourcePath} ${entrypoint} ${bp.runtime.join(' ')} ${bp.stack.join(' ')}`.toLowerCase()}>
            <div class="registry-v2-name">
              <span>@{bp.creator.toLowerCase().replace(/\s+/g, '-')} / {bp.slug}</span>
              <strong>{bp.title}</strong>
              <p>{bp.summary}</p>
            </div>
            <div class="registry-v2-facts">
              <div><span>Source</span><b>{source.repo}</b></div>
              <div><span>Path</span><b>{source.sourcePath || `buildprints/${bp.slug}`}</b></div>
              <div><span>Entrypoint</span><b>{entrypoint}</b></div>
              <div><span>Published</span><b>{publishedLabel(bp.updatedAt)}</b></div>
            </div>
            <div class="registry-v2-state" aria-label="Buildprint state">
              <span>{bootstrapReady ? 'Bootstrap configured' : 'Manifest review needed'}</span>
              <span>{hasRuns ? 'Run artifacts linked' : 'No public runs yet'}</span>
              <span><b data-card-views>--</b> views</span>
              <span><b data-card-likes>--</b> likes</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <script>
    const search = document.querySelector('#search');
    const rows = Array.from(document.querySelectorAll('.registry-v2-row'));
    const count = document.querySelector('#resultCount');
    function apply() {
      const q = String(search?.value || '').trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const ok = !q || row.getAttribute('data-search')?.includes(q);
        row.classList.toggle('hidden', !ok);
        if (ok) visible += 1;
      }
      if (count) count.textContent = `Showing ${visible} Buildprint${visible === 1 ? '' : 's'}`;
    }
    search?.addEventListener('input', apply);
    apply();

    const numberFormat = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
    document.querySelectorAll('[data-engagement-card][data-slug]').forEach(async (card) => {
      const slug = card.getAttribute('data-slug');
      const views = card.querySelector('[data-card-views]');
      const likes = card.querySelector('[data-card-likes]');
      if (!slug || !views || !likes) return;
      try {
        const response = await fetch(`/api/buildprints/${encodeURIComponent(slug)}/engagement`);
        if (!response.ok) throw new Error('engagement_unavailable');
        const payload = await response.json();
        views.textContent = numberFormat.format(payload.views || 0);
        likes.textContent = numberFormat.format(payload.likes || 0);
      } catch {
        views.textContent = '-';
        likes.textContent = '-';
      }
    });
  </script>
</BaseLayout>
