---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildprints, liveBuildprints } from '@/lib/buildprints';
import { badgeIcon, iconHtml as icon } from '@/lib/icons';
const featured = liveBuildprints.filter((bp) => bp.featured).slice(0, 4);
const trustLabel = (bp) => {
  if (bp.planned || bp.status === 'coming-soon') return 'PLANNED';
  if (bp.status === 'validated') return 'Validated';
  if (bp.status === 'draft') return 'DRAFT';
  if (bp.checks.length > 0) return 'CHECKED';
  return 'READY';
};
const trustTip = (bp) => {
  if (bp.planned || bp.status === 'coming-soon') return 'Planned Buildprint; package details are not ready yet.';
  if (bp.status === 'validated') return 'Validated by snapshot bootstrap, Codex dry-run, local tests, and gated publishing checks.';
  if (bp.status === 'draft') return 'Draft Buildprint; useful for review but not fully validated.';
  if (bp.checks.length > 0) return 'Has defined quality checks, but still needs full dry-run validation.';
  return 'Ready to inspect.';
};
const categoryTip = (bp) => `${bp.category}: ${bp.tier} Buildprint package`;
const sections = [
  { title: 'Product OS', items: buildprints.filter((bp) => bp.category === 'Product OS').slice(0, 5) },
  { title: 'Features & Extensions', items: buildprints.filter((bp) => bp.category === 'Feature / Extension').slice(0, 5) },
  { title: 'Framework Blueprints', items: buildprints.filter((bp) => bp.category === 'Framework / Architecture').slice(0, 5) },
  { title: 'Workflow OS', items: buildprints.filter((bp) => bp.category === 'Workflow OS').slice(0, 5) },
];
---
<BaseLayout title="Agent Buildprint — reusable specs for AI coding agents" description="Reusable implementation packages with specs, phases, contracts, and checks for AI coding agents.">
  <main>
    <section class="container hero clean-hero platform-hero">
      <div class="hero-copy">
        <span class="pill dossier-pill"><b>⌁</b> inspected plans for coding agents</span>
        <h1>Give your coding agent a real implementation plan.</h1>
        <p class="lead">Buildprints package the decisions agents usually guess: architecture, behavior, contracts, phases, and validation gates.</p>
        <div class="actions">
          <a class="btn primary" href="/buildprints/">Try a validated Buildprint</a>
          <a class="btn" href="#how-it-works">See how it works</a>
        </div>
      </div>
      <aside class="blueprint-dossier-card" aria-label="Buildprint package preview">
        <div class="dossier-topline"><span>BUILDPRINT PACKAGE</span><b>VALIDATED</b></div>
        <div class="dossier-file-tree">
          <div><code>BUILDPRINT.md</code><span>architecture truth</span></div>
          <div><code>SPEC.md</code><span>behavior contract</span></div>
          <div><code>PLAN.md</code><span>phase rails</span></div>
          <div><code>CONTRACTS.md</code><span>interfaces</span></div>
          <div><code>TEST_MATRIX.md</code><span>validation gates</span></div>
        </div>
        <div class="dossier-ledger">
          <span>CLI snapshot ✓</span><span>Tests ✓</span><span>Browser smoke ✓</span>
        </div>
        <p>agent reads → implements phases → runs checks</p>
      </aside>
    </section>

    <section id="how-it-works" class="container section visual-proof-section" aria-labelledby="visual-proof-title">
      <div class="section-head simple proof-head"><div><span class="eyebrow"><b>↯</b> Why Buildprints</span><h2 id="visual-proof-title">AI agents are fast, but they guess.</h2><p>Buildprints give agents explicit plans before they write code — so the result drifts less and is easier to check.</p></div></div>
      <div class="blueprint-explainer">
        <div class="proof-card bad">
          <span class="proof-label">Vague prompt</span>
          <code>“Build me an AI blog system”</code>
          <ul>
            <li>agent guesses the architecture</li>
            <li>approval gates get forgotten</li>
            <li>edge cases appear late</li>
            <li>hard to verify “done”</li>
          </ul>
        </div>
        <div class="blueprint-plan-card">
          <span class="proof-label">Buildprint</span>
          <div class="plan-file"><b>BUILDPRINT.md</b><span>what to build</span></div>
          <div class="plan-file"><b>SPEC.md</b><span>how it behaves</span></div>
          <div class="plan-file"><b>PLAN.md</b><span>what to do first</span></div>
          <div class="plan-file"><b>phases/*.md</b><span>small implementation steps</span></div>
          <div class="plan-file"><b>TEST_MATRIX.md</b><span>how to verify</span></div>
        </div>
        <div class="proof-card good">
          <span class="proof-label">Agent outcome</span>
          <code>read plan → implement phases → run checks</code>
          <ul>
            <li>less architecture drift</li>
            <li>clearer handoff to Codex/Cursor/Claude</li>
            <li>checks and acceptance gates included</li>
            <li>humans can inspect the plan</li>
          </ul>
        </div>
      </div>
      <div class="proof-flow" aria-label="Buildprint flow">
        <span>Vague prompt → agent guesses → drift/errors</span><b>vs</b><span>Buildprint package → agent follows plan → checked implementation</span>
      </div>
    </section>

    <section class="container section">
      <div class="section-head simple"><div><span class="eyebrow"><b>★</b> Featured</span><h2>Browse Buildprints for products, features, architectures, workflows, and integrations.</h2></div><a class="link" href="/buildprints/">View registry →</a></div>
      <div class="grid cards featured-grid">
        {featured.map((bp) => <a class="mini-card clickable-card" href={`/buildprints/${bp.slug}/`}>
          <div class="card-topline"><span class="plain-category" title={categoryTip(bp)}><b>{badgeIcon(bp.category)}</b>{bp.category}</span><span class="status-word" title={trustTip(bp)}>{trustLabel(bp)}</span></div>
          <h3>{bp.title}</h3>
          <p>{bp.summary}</p>
          <div class="stack-row"><span class="stack-line" title={bp.stack.join(' · ')}>{bp.stack.slice(0, 3).join(' · ')}</span><span class="stack-icons" aria-label={`Stack icons: ${(bp.iconKeys ?? []).join(', ')}`}>{(bp.iconKeys ?? []).slice(0,3).map((key) => <i class={`tech-icon ${key}`} title={key} set:html={icon(key)} />)}</span></div>
        </a>)}
      </div>
    </section>

    <section class="container section rows">
      {sections.map((section) => <div class="catalog-row">
        <div class="row-head"><h2>{section.title}</h2><a class="link" href="/buildprints/">Explore →</a></div>
        <div class="row-scroll">
          {section.items.map((bp) => <a class={`row-card ${bp.planned ? 'muted-card' : ''}`} href={bp.planned ? '/buildprints/' : `/buildprints/${bp.slug}/`}>
            <div class="row-top"><span><b>{badgeIcon(bp.category)}</b>{bp.category}</span><span class="row-status"><b>{badgeIcon(bp.status)}</b>{trustLabel(bp)}</span></div>
            <b>{bp.title}</b>
            <p>{bp.summary}</p>
            <small>{bp.stack.slice(0, 3).join(' · ')}</small>
          </a>)}
        </div>
      </div>)}
    </section>

    <section class="container section how-section">
      <div class="section-head simple"><div><span class="eyebrow"><b>◆</b> Use it</span><h2>Copy the plan, or let the CLI fetch it.</h2></div></div>
      <div class="grid how-grid">
        <div class="panel quiet"><span class="step-number">1</span><h3>Choose a blueprint</h3><p>Pick a product, feature, architecture, or workflow Buildprint from the registry.</p></div>
        <div class="panel quiet"><span class="step-number">2</span><h3>Give it to your agent</h3><pre>npx --yes github:DomEscobar/agent-buildprint start https://agent-buildprint.com/buildprints/ai-influencer-os/package.json</pre></div>
        <div class="panel quiet"><span class="step-number">3</span><h3>Build with checks</h3><p>Tell Codex, Cursor, or Claude Code to follow the plan, implement phases, and run the validation gates.</p></div>
      </div>
    </section>

    <section class="container section two-col">
      <div class="panel quiet"><span class="eyebrow"><b>⌁</b> Mapper</span><h2>Have a repo already?</h2><p>Use Mapper OS as a coding-agent workflow: map the system, propose scoped candidates, choose one, extract a Buildprint, then reversal-test it — no CLI required.</p><pre>Read Mapper OS
→ SYSTEM_MAP.md
→ BUILDPRINT_CANDIDATES.md
→ selected buildprint-submission/
→ REVERSAL_REPORT.md</pre></div>
      <div class="panel quiet"><span class="eyebrow"><b>✦</b> Creator angle</span><h2>Architects and experienced devs can publish reusable plans.</h2><p>Package a repeatable architecture, feature, or workflow into a reusable Buildprint others can use with their coding agents.</p><pre>architecture + spec + phases + checks</pre></div>
    </section>
  </main>
</BaseLayout>
