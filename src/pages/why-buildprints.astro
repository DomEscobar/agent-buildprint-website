---
import TechName from '@/components/TechName.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Why Buildprints — slide deck for coding agents"
  description="A clean slide-by-slide story explaining why coding agents need reusable architecture packets before implementation starts."
>
  <main class="pitch-deck" aria-label="Why Agent Buildprint slide deck">
    <div class="deck-stage" data-deck>
      <section class="deck-slide is-active cover-slide" data-slide aria-labelledby="why-title">
        <div class="slide-content">
          <p class="deck-eyebrow">Agent Buildprint / short story</p>
          <h1 id="why-title">A coding agent should not start from a blank prompt.</h1>
          <p>It should start from a reviewed plan: what to build, what to avoid, which files matter, and how “done” will be checked.</p>
        </div>
        <div class="cover-art" aria-hidden="true">
          <div class="blueprint-sun">AGB</div>
          <span>Intent</span><span>Scope</span><span>Contracts</span><span>Checks</span>
        </div>
      </section>

      <section class="deck-slide chaos-slide" data-slide>
        <div class="slide-content">
          <p class="deck-eyebrow">01 / The problem</p>
          <h2>Fast implementation is not the same as correct implementation.</h2>
          <p>When the plan lives only in a prompt, the agent has to infer architecture, edge cases, sequencing, and acceptance criteria at the same time it writes code.</p>
        </div>
        <div class="chaos-map" aria-label="Common failure points">
          <b>Vague request</b>
          <i style="--x:12%;--y:24%">guessed architecture</i>
          <i style="--x:56%;--y:20%">unclear scope</i>
          <i style="--x:62%;--y:62%">late validation</i>
          <i style="--x:16%;--y:70%">weak handoff</i>
        </div>
      </section>

      <section class="deck-slide insight-slide" data-slide>
        <div class="giant-word" aria-hidden="true">PLAN</div>
        <div class="slide-content wide">
          <p class="deck-eyebrow">02 / The missing layer</p>
          <h2>The most valuable work happens before code generation.</h2>
          <p>Architecture, boundaries, contracts, risks, and validation gates should be packaged first — then the coding agent can execute inside a clear frame.</p>
        </div>
      </section>

      <section class="deck-slide object-slide" data-slide>
        <div class="slide-content">
          <p class="deck-eyebrow">03 / The package</p>
          <h2>A Buildprint is a reusable implementation brief.</h2>
          <p>It turns expert context into files an agent can read, follow, and verify without inventing the plan mid-build.</p>
        </div>
        <div class="sheet-stack" aria-label="Buildprint files">
          <article><b>BUILDPRINT.md</b><span>system purpose and architecture</span></article>
          <article><b>SPEC.md</b><span>behavior, rules, and edge cases</span></article>
          <article><b>PLAN.md</b><span>ordered implementation phases</span></article>
          <article><b>CONTRACTS.md</b><span>interfaces, data, and side effects</span></article>
          <article><b>TEST_MATRIX.md</b><span>risks mapped to checks</span></article>
        </div>
      </section>

      <section class="deck-slide bootstrap-slide" data-slide>
        <div class="slide-content wide">
          <p class="deck-eyebrow">04 / The handoff</p>
          <h2><code>agb start</code> gives the agent exact snapshots.</h2>
          <p>The package is fetched as real files, not copied from a web card. The agent gets a concrete next step and the human can inspect the same source of truth.</p>
        </div>
        <div class="command-strip" aria-hidden="true">
          <span>$ agb start package.json .</span>
          <b>→</b>
          <span>.buildprint/snapshots/*</span>
        </div>
      </section>

      <section class="deck-slide tunnel-slide" data-slide>
        <div class="slide-content">
          <p class="deck-eyebrow">05 / The workflow</p>
          <h2>The agent follows a sequence instead of improvising.</h2>
          <p>Choose the Buildprint, bootstrap the files, read the package, implement in phases, run checks, then report evidence and gaps.</p>
        </div>
        <div class="gate-tunnel" aria-label="Execution sequence">
          <span>Choose</span><span>Bootstrap</span><span>Build</span><span>Validate</span>
        </div>
      </section>

      <section class="deck-slide proof-slide" data-slide>
        <div class="slide-content">
          <p class="deck-eyebrow">06 / The standard</p>
          <h2>“Done” should mean there is evidence.</h2>
          <p>Validated Buildprints include build/test output, raw file checks, bootstrap checks, scoped claims, and explicit non-goals.</p>
        </div>
        <div class="terminal-card" aria-label="Proof checklist">
          <p><em>Build</em><span>npm run build passed</span></p>
          <p class="ok"><em>Tests</em><span>12/12 passed</span></p>
          <p><em>Files</em><span>raw URLs checked</span></p>
          <p class="warn"><em>Claims</em><span>non-goals documented</span></p>
        </div>
      </section>

      <section class="deck-slide category-slide" data-slide>
        <div class="slide-content wide">
          <p class="deck-eyebrow">07 / The category</p>
          <h2><TechName name="Docker" /> Hub for environments. <TechName name="npm" /> for code. Buildprints for agent architecture.</h2>
          <p>Architecture becomes something teams can reuse, inspect, benchmark, improve, and hand to different coding agents.</p>
        </div>
      </section>

      <section class="deck-slide final-slide" data-slide>
        <div class="slide-content wide">
          <p class="deck-eyebrow">08 / The ask</p>
          <h2>Separate planning from execution.</h2>
          <p>Pick a Buildprint. Bootstrap exact snapshots. Let the agent build from a professional brief — then verify the result.</p>
          <div class="deck-actions">
            <a class="deck-btn primary" href="/buildprints/">Browse Buildprints</a>
            <a class="deck-btn" href="/buildprints/superpowers-skill-methodology-harness/">See Superpowers Harness</a>
          </div>
        </div>
      </section>
    </div>

    <div class="deck-hud" aria-label="Slide controls">
      <button type="button" class="deck-arrow" data-prev aria-label="Previous slide">←</button>
      <div class="deck-count"><span data-current>01</span><i>/</i><span data-total>09</span></div>
      <button type="button" class="deck-arrow" data-next aria-label="Next slide">→</button>
    </div>
    <div class="deck-dots" data-dots aria-label="Slide dots"></div>
    <p class="deck-hint">Use ← → keys, buttons, or swipe</p>
  </main>

  <script is:inline>
    const deck = document.querySelector('[data-deck]');
    const slides = Array.from(document.querySelectorAll('[data-slide]'));
    const current = document.querySelector('[data-current]');
    const total = document.querySelector('[data-total]');
    const dotsWrap = document.querySelector('[data-dots]');
    const prev = document.querySelector('[data-prev]');
    const next = document.querySelector('[data-next]');
    let index = 0;
    let touchStart = null;
    total.textContent = String(slides.length).padStart(2, '0');
    const dots = slides.map((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
      dot.addEventListener('click', () => go(i));
      dotsWrap.appendChild(dot);
      return dot;
    });
    function go(nextIndex) {
      index = Math.max(0, Math.min(slides.length - 1, nextIndex));
      deck.style.setProperty('--slide-index', index);
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      current.textContent = String(index + 1).padStart(2, '0');
      history.replaceState(null, '', `#slide-${index + 1}`);
    }
    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));
    window.addEventListener('keydown', (event) => {
      if (['ArrowRight', 'PageDown', ' '].includes(event.key)) { event.preventDefault(); go(index + 1); }
      if (['ArrowLeft', 'PageUp'].includes(event.key)) { event.preventDefault(); go(index - 1); }
      if (event.key === 'Home') go(0);
      if (event.key === 'End') go(slides.length - 1);
    });
    deck.addEventListener('touchstart', (event) => { touchStart = event.touches[0].clientX; }, { passive: true });
    deck.addEventListener('touchend', (event) => {
      if (touchStart === null) return;
      const delta = event.changedTouches[0].clientX - touchStart;
      if (Math.abs(delta) > 42) go(index + (delta < 0 ? 1 : -1));
      touchStart = null;
    }, { passive: true });
    const hashMatch = location.hash.match(/slide-(\d+)/);
    go(hashMatch ? Number(hashMatch[1]) - 1 : 0);
  </script>
</BaseLayout>
