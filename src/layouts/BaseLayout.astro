---
import '../styles.css';
const {
  title = 'Agent Buildprint',
  description = 'Reusable specs for building software with AI coding agents.',
  image = '/og-image.svg',
} = Astro.props;
const absoluteImage = new URL(image, Astro.url.origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="nav-shell">
      <div class="container nav">
        <a class="logo" href="/" aria-label="Agent Buildprint home">
          <img src="/logo.svg" alt="" aria-hidden="true" />
          <span><b>Agent</b> Buildprint</span>
        </a>
        <nav class="navlinks" aria-label="Primary navigation">
          <a href="/docs/">Docs</a>
          <a href="https://github.com/DomEscobar/agent-buildprint">GitHub</a>
          <span class="nav-auth" data-nav-auth><a href="/profile/">Sign in</a></span>
          <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch color theme"><span class="theme-dot" aria-hidden="true"></span><span data-theme-label>Color</span></button>
        </nav>
      </div>
    </header>
    <div id="main-content">
      <slot />
    </div>
    <footer class="container footer">
      <span>Agent Buildprint - reusable specs for AI coding agents.</span>
      <span class="footer-links"><a href="/docs/">Docs</a><a href="/buildprints/">Browse</a><a href="/standard/">Standard</a><a href="/create/">Create</a><a href="https://github.com/DomEscobar/agent-buildprint">GitHub</a><a href="/llms.txt">Agent nav</a><a href="/buildprints/index.json">JSON</a></span>
    </footer>
    <div class="artifact-modal-shell" data-artifact-modal hidden>
      <div class="artifact-modal-backdrop" data-artifact-close></div>
      <section class="artifact-modal" role="dialog" aria-modal="true" aria-labelledby="artifactModalTitle">
        <header class="artifact-modal-head">
          <div>
            <span class="eyebrow"><b>↳</b> Proof artifact</span>
            <h2 id="artifactModalTitle" data-artifact-title>Artifact</h2>
          </div>
          <button class="artifact-modal-close" type="button" data-artifact-close aria-label="Close artifact viewer">x</button>
        </header>
        <div class="artifact-modal-actions">
          <div class="artifact-image-controls" data-image-controls hidden>
            <button type="button" data-image-zoom-out aria-label="Zoom out">-</button>
            <button type="button" data-image-zoom-reset aria-label="Reset zoom">Reset</button>
            <button type="button" data-image-zoom-in aria-label="Zoom in">+</button>
          </div>
          <a class="btn" href="#" target="_blank" rel="noreferrer" data-artifact-raw>Open raw file</a>
        </div>
        <div class="artifact-modal-body readme-rendered" data-artifact-content></div>
      </section>
    </div>
    <script is:inline>
      const themeToggle = document.getElementById('themeToggle');
      const themeLabel = document.querySelector('[data-theme-label]');
      function syncThemeLabel() {
        if (themeLabel) themeLabel.textContent = document.documentElement.dataset.theme === 'dark' ? 'Light' : 'Dark';
      }
      syncThemeLabel();
      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        syncThemeLabel();
      });
      const navAuth = document.querySelector('[data-nav-auth]');
      fetch('/api/auth/me')
        .then((response) => response.ok ? response.json() : null)
        .then((payload) => {
          if (!navAuth || !payload?.user) return;
          const user = payload.user;
          const link = document.createElement('a');
          link.className = 'nav-profile';
          link.href = '/profile/';
          const avatar = document.createElement('img');
          avatar.src = user.avatarUrl || '/logo.svg';
          avatar.alt = '';
          const label = document.createElement('span');
          label.textContent = user.githubLogin || 'Profile';
          link.append(avatar, label);
          navAuth.replaceChildren(link);
        })
        .catch(() => {});

      const artifactModal = document.querySelector('[data-artifact-modal]');
      const artifactTitle = document.querySelector('[data-artifact-title]');
      const artifactContent = document.querySelector('[data-artifact-content]');
      const artifactRaw = document.querySelector('[data-artifact-raw]');
      const imageControls = document.querySelector('[data-image-controls]');
      const imageZoomIn = document.querySelector('[data-image-zoom-in]');
      const imageZoomOut = document.querySelector('[data-image-zoom-out]');
      const imageZoomReset = document.querySelector('[data-image-zoom-reset]');
      const artifactCloseControls = document.querySelectorAll('[data-artifact-close]');
      let activeImageState = null;
      function escapeHtml(value) {
        return value.replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        }[char]));
      }
      function inlineMarkdown(value) {
        return escapeHtml(value)
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');
      }
      function renderArtifact(text, href) {
        if (/\.(diff|patch)$/i.test(href)) {
          return `<pre><code>${escapeHtml(text)}</code></pre>`;
        }
        const lines = text.split(/\r?\n/);
        const html = [];
        let inCode = false;
        let code = [];
        let codeLang = '';
        let list = [];
        let paragraph = [];
        function flushList() {
          if (!list.length) return;
          html.push(`<ul>${list.map((item) => `<li>${inlineMarkdown(item)}</li>`).join('')}</ul>`);
          list = [];
        }
        function flushParagraph() {
          if (!paragraph.length) return;
          html.push(`<p>${inlineMarkdown(paragraph.join(' '))}</p>`);
          paragraph = [];
        }
        function flushCode() {
          if (!code.length) return;
          if (codeLang.toLowerCase() === 'mermaid') {
            html.push(`<div class="mermaid-diagram" data-mermaid-diagram><pre class="mermaid">${escapeHtml(code.join('\n'))}</pre></div>`);
          } else {
            html.push(`<pre><code>${escapeHtml(code.join('\n'))}</code></pre>`);
          }
          code = [];
          codeLang = '';
        }
        for (const line of lines) {
          const fence = line.match(/^```(\S+)?/);
          if (fence && !inCode) {
            flushList();
            flushParagraph();
            inCode = true;
            codeLang = fence[1] || '';
            code = [];
            continue;
          }
          if (fence && inCode) {
            inCode = false;
            flushCode();
            continue;
          }
          if (inCode) {
            code.push(line);
            continue;
          }
          if (!line.trim()) {
            flushList();
            flushParagraph();
            continue;
          }
          const heading = line.match(/^(#{1,4})\s+(.+)$/);
          if (heading) {
            flushList();
            flushParagraph();
            const level = Math.min(heading[1].length + 1, 5);
            html.push(`<h${level}>${inlineMarkdown(heading[2])}</h${level}>`);
            continue;
          }
          const bullet = line.match(/^\s*[-*]\s+(.+)$/);
          if (bullet) {
            flushParagraph();
            list.push(bullet[1]);
            continue;
          }
          paragraph.push(line.trim());
        }
        flushCode();
        flushList();
        flushParagraph();
        return html.join('\n');
      }
      function closeArtifactModal() {
        if (!artifactModal) return;
        artifactModal.hidden = true;
        if (imageControls) imageControls.hidden = true;
        artifactContent?.classList.remove('artifact-modal-body-image');
        activeImageState = null;
        document.body.classList.remove('artifact-modal-open');
      }
      function updateImageTransform() {
        if (!activeImageState?.image) return;
        const { image, scale, x, y } = activeImageState;
        image.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${scale})`;
      }
      function setImageScale(nextScale) {
        if (!activeImageState) return;
        activeImageState.scale = Math.max(1, Math.min(5, nextScale));
        if (activeImageState.scale === 1) {
          activeImageState.x = 0;
          activeImageState.y = 0;
        }
        updateImageTransform();
      }
      function resetImageZoom() {
        if (!activeImageState) return;
        activeImageState.scale = 1;
        activeImageState.x = 0;
        activeImageState.y = 0;
        updateImageTransform();
      }
      function pointerDistance(points) {
        const [a, b] = points;
        return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
      }
      function openImageModal(link) {
        if (!artifactModal || !artifactContent || !artifactTitle || !artifactRaw) return;
        const href = link.getAttribute('href') || '';
        const title = link.getAttribute('data-visual-title') || link.querySelector('img')?.alt || 'Visual preview';
        const alt = link.querySelector('img')?.alt || title;
        artifactTitle.textContent = title;
        artifactRaw.href = href;
        artifactRaw.textContent = 'Open image file';
        if (imageControls) imageControls.hidden = false;
        artifactContent.classList.add('artifact-modal-body-image');
        artifactContent.innerHTML = `
          <div class="artifact-image-stage" data-image-stage>
            <img src="${escapeHtml(href)}" alt="${escapeHtml(alt)}" draggable="false" data-image-lightbox-img>
          </div>`;
        artifactModal.hidden = false;
        document.body.classList.add('artifact-modal-open');
        const stage = artifactContent.querySelector('[data-image-stage]');
        const image = artifactContent.querySelector('[data-image-lightbox-img]');
        const pointers = new Map();
        activeImageState = { image, scale: 1, x: 0, y: 0, startX: 0, startY: 0, startPanX: 0, startPanY: 0, pinchStart: 0, pinchScale: 1 };
        stage?.addEventListener('wheel', (event) => {
          event.preventDefault();
          setImageScale(activeImageState.scale + (event.deltaY < 0 ? .18 : -.18));
        }, { passive: false });
        stage?.addEventListener('pointerdown', (event) => {
          stage.setPointerCapture?.(event.pointerId);
          pointers.set(event.pointerId, event);
          if (pointers.size === 1) {
            activeImageState.startX = event.clientX;
            activeImageState.startY = event.clientY;
            activeImageState.startPanX = activeImageState.x;
            activeImageState.startPanY = activeImageState.y;
          }
          if (pointers.size === 2) {
            activeImageState.pinchStart = pointerDistance([...pointers.values()]);
            activeImageState.pinchScale = activeImageState.scale;
          }
        });
        stage?.addEventListener('pointermove', (event) => {
          if (!pointers.has(event.pointerId)) return;
          pointers.set(event.pointerId, event);
          if (pointers.size === 2) {
            const distance = pointerDistance([...pointers.values()]);
            if (activeImageState.pinchStart) setImageScale(activeImageState.pinchScale * (distance / activeImageState.pinchStart));
            return;
          }
          if (pointers.size === 1 && activeImageState.scale > 1) {
            activeImageState.x = activeImageState.startPanX + event.clientX - activeImageState.startX;
            activeImageState.y = activeImageState.startPanY + event.clientY - activeImageState.startY;
            updateImageTransform();
          }
        });
        function releasePointer(event) {
          pointers.delete(event.pointerId);
        }
        stage?.addEventListener('pointerup', releasePointer);
        stage?.addEventListener('pointercancel', releasePointer);
      }
      imageZoomIn?.addEventListener('click', () => setImageScale((activeImageState?.scale || 1) + .35));
      imageZoomOut?.addEventListener('click', () => setImageScale((activeImageState?.scale || 1) - .35));
      imageZoomReset?.addEventListener('click', resetImageZoom);
      artifactCloseControls.forEach((control) => control.addEventListener('click', closeArtifactModal));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeArtifactModal();
      });
      document.addEventListener('click', async (event) => {
        const imageLink = event.target.closest?.('[data-visual-lightbox]');
        if (imageLink) {
          event.preventDefault();
          openImageModal(imageLink);
          return;
        }
        const link = event.target.closest?.('a.proof-artifact-link, .proof-hero a.btn');
        if (!link || !artifactModal || !artifactContent || !artifactTitle || !artifactRaw) return;
        const href = link.getAttribute('href') || '';
        if (!/\.(md|txt|diff|patch)$/i.test(href)) return;
        event.preventDefault();
        const label = link.querySelector('code')?.textContent || link.textContent?.trim() || 'Artifact';
        artifactTitle.textContent = label;
        artifactRaw.href = href;
        artifactRaw.textContent = 'Open raw file';
        if (imageControls) imageControls.hidden = true;
        artifactContent.classList.remove('artifact-modal-body-image');
        artifactContent.innerHTML = '<p>Loading artifact…</p>';
        artifactModal.hidden = false;
        document.body.classList.add('artifact-modal-open');
        try {
          const response = await fetch(href);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          artifactContent.innerHTML = renderArtifact(await response.text(), href);
          window.renderMermaidDiagrams?.(artifactContent);
        } catch (error) {
          artifactContent.innerHTML = `<p>Could not load this artifact inline. Use the raw file link above.</p>`;
        }
      });
    </script>
  </body>
</html>
